# deploy.sh operator configuration.
#
# Copy this file to `deploy.env` (gitignored) and fill in real values.
# `deploy.sh` sources `./deploy.env` automatically when it exists.
#
# deploy.sh deploys one or more launchd-supervised Marfa service
# instances that share a single source tree on a remote host.

# SSH host the deploy connects to — configure it in ~/.ssh/config.
# Overridable per-run with `./deploy.sh --host <host>`.
DEPLOY_HOST=my-deploy-host

# Source tree on the host that deploy.sh pulls into and builds.
# Single-quote any $HOME — it must expand on the remote host, not locally.
SERVICE_DIR='$HOME/marfa'

# Branch to deploy.
REPO_BRANCH=main

# Managed services. Each is described by the Nth entry of the four
# comma-separated lists below — all four must be the same length. A
# single-instance deploy has one entry per list; the example here shows a
# two-instance deploy (a primary instance plus a conformance instance)
# sharing one source tree.
#
#   DEPLOY_SERVICE_NAMES    human-readable name per service
#   DEPLOY_SERVICE_LABELS   launchd label per service (the restart target)
#   DEPLOY_SERVICE_PORTS    health-check port per service
#   DEPLOY_SERVICE_DB_URLS  Postgres URL per service (the migration target)
DEPLOY_SERVICE_NAMES=primary,conformance
DEPLOY_SERVICE_LABELS=com.example.marfa.primary,com.example.marfa.conformance
DEPLOY_SERVICE_PORTS=8600,8601
DEPLOY_SERVICE_DB_URLS=postgres://user:pass@localhost:5432/marfa,postgres://user:pass@localhost:5432/marfa_conformance
