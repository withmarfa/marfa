# Required secrets for the per-Integration Cloudflare Worker.
# Set via `wrangler secret put <NAME> --env <staging|production>` after the
# first deploy. See integrations/CLAUDE.md → "First-deploy operator setup
# (hosted substrate, T-255)" for context.
#
# Non-secret per-environment values (INTEGRATION_NAME, MANIFEST_CRON,
# ENVIRONMENT) live in the [vars] block of wrangler.toml, not here.

MYME_API_URL=
MYME_RUNTIME_CONTROL_URL=
MYME_RUNTIME_BROKER_KEY=
