# Required secrets for the mymehq-inbox Email Worker.
# Set via `wrangler secret put <NAME> --env <staging|production>` after the
# first deploy. See integrations/mymehq-inbox/CLAUDE.md → "Email Worker"
# for the wire-protocol context.
#
# Unlike the per-Integration Workers, this one uses a Service Binding to
# reach the runtime-control Worker (RUNTIME_CONTROL in wrangler.toml) and
# does NOT carry the canonical three integration-worker secrets.

# system.connection id for the inbox connection on the Myme server.
# Baked into the webhook path the Email Worker forwards to.
CONNECTION_ID=

# Shared HMAC-SHA256 secret. Matches the subscription secret stored on the
# Myme server's inbound_webhooks row for this connection.
WEBHOOK_SECRET=
