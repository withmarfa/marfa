{
  "name": "@withmarfa/integration-readwise-reader",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Bidirectional Readwise Reader integration. Schedule trigger drains the v3 documents API for saved documents; item-event trigger pushes readwise.document creates, edits and trashes back to Reader.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsup"
  },
  "dependencies": {
    "@withmarfa/runtime-sdk": "workspace:*",
    "@withmarfa/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260602.1",
    "@withmarfa/runtime-test": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "tsup": "^8.5.1",
    "wrangler": "^4.96.0"
  }
}
