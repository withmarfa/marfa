# Required secrets for the Inbox Email Worker.
# Set via `wrangler secret put <NAME> --env <staging|production>` after the
# first deploy. See integrations/marfa/inbox/AGENTS.md → "Email Worker"
# for the wire-protocol context. The Worker posts the parsed capture
# payload straight to the Marfa server's webhook receipt route over HTTPS.

# system.connection id for the inbox connection on the Marfa server.
# Baked into the webhook path the Email Worker forwards to.
CONNECTION_ID=

# Shared HMAC-SHA256 secret. Matches the subscription secret stored on the
# Marfa server's inbound_webhooks row for this connection.
WEBHOOK_SECRET=
