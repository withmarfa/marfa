# Required secrets for the per-Integration Cloudflare Worker.
# Set via `wrangler secret put <NAME> --env <staging|prod>` after the
# first deploy. See integrations/AGENTS.md for context.
#
# Non-secret per-environment values (INTEGRATION_NAME, MANIFEST_CRON,
# ENVIRONMENT) live in the [vars] block of wrangler.toml, not here.

MARFA_API_URL=
MARFA_RUNTIME_CONTROL_URL=
MARFA_WORKER_IDENTITY_KEY=

# Optional. Podcast Index enrichment runs only when both are present, and
# reading RSS never depends on them. The key alone cannot authenticate:
# the authorization header is a digest over the key and the secret
# together, so a key without its secret is a lost credential rather than a
# usable one.
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=
