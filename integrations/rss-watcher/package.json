{
  "name": "@withmarfa/integration-rss-watcher",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Read-only RSS/Atom feed connector. Polls a feed on a schedule and creates a core.bookmark per new entry. Exists as the simplest end-to-end test of the schedule + cursor + outbound-write substrate.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsup"
  },
  "dependencies": {
    "@withmarfa/runtime-sdk": "workspace:*",
    "@withmarfa/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260602.1",
    "@withmarfa/runtime-test": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "tsup": "^8.5.1",
    "wrangler": "^4.96.0"
  }
}
