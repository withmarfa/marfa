# Marfa server — example configuration.
#
# Copy to `.env` and fill in. This is a curated starter, not the full list —
# the complete reference is the self-hosting Configuration docs. Values shown
# are the defaults unless noted.

# --- Server ---
PORT=8600

# --- Database ---
# `sqlite` (default, zero-config, single-space) or `pg` (Postgres; required
# for multi-space and for the local integration runtime).
DB_DIALECT=sqlite
# SQLITE_PATH=./data/marfa.db
# For Postgres, set DB_DIALECT=pg and a connection string:
# DB_DIALECT=pg
# DATABASE_URL=postgres://marfa:password@localhost:5432/marfa

# --- Blob storage ---
BLOB_BACKEND=filesystem
BLOB_PATH=./data/blobs
# MAX_BLOB_SIZE=52428800   # max upload size in bytes (default 50MB); over → 413
# For S3 / R2 / MinIO:
# BLOB_BACKEND=s3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=             # custom endpoint for R2 / MinIO; omit for AWS
# S3_FORCE_PATH_STYLE=     # default true when an endpoint is set, which is
#                          # what MinIO needs. Set false for a store that
#                          # presents virtual-hosted URLs. Read only when
#                          # S3_ENDPOINT is set; AWS is always virtual-hosted.

# --- Behind a reverse proxy ---
# By default the peer address is the client address and any forwarded
# header is ignored, because a client can send one itself. Opt in with
# exactly one of these.
# TRUSTED_PROXY_CIDRS=     # comma-separated proxy CIDRs; x-forwarded-for
#                          # is believed only from a peer inside one
# TRUSTED_PROXY_HEADER=    # for a platform whose edge has no pinnable
#                          # address and overwrites one header, e.g.
#                          # x-real-ip. Takes precedence over the CIDRs.
#                          # Never set it where clients can reach the
#                          # process directly: it is then spoofable.

# --- Security (required in production) ---
# Salt for hashing API keys. Generate once with `openssl rand -hex 32`.
# Rotating it invalidates every existing API key.
API_KEY_SALT=change-me-run-openssl-rand-hex-32
# Secret for signing auth session cookies. Generate with `openssl rand -hex 32`.
# Required in production; rotating it invalidates existing sessions/ciphertext.
MARFA_AUTH_SECRET=change-me-run-openssl-rand-hex-32
# Comma-separated browser origins allowed to call the API cross-origin.
# Required if a browser client signs in against this server in hosted mode.
# CORS_ORIGINS=http://localhost:5173

# --- Auth mode ---
# `keys` (default): single-user, API-key only. Bootstrap the first key with
# an unauthenticated POST /keys on a fresh server (see the quickstart).
# `hosted`: multi-space with user accounts + OAuth sign-in.
# AUTH_MODE=keys
# Public URL clients reach this server at (drives cookie domain + OAuth issuer).
# MARFA_AUTH_BASE_URL=http://localhost:8600
# Enable email+password sign-up (hosted mode). Turn on to create the first
# account, then off. Note: with no email backend, verification is skipped so
# the first admin is never locked out.
# MARFA_AUTH_ALLOW_SIGNUP=false

# --- Integrations runtime ---
# Integration jobs run in-process via Postgres (pg-boss).
# REQUIRES DB_DIALECT=pg — on SQLite the runtime is simply off (no crash).

# --- Email (transactional: verify, forgot-password, magic-link) ---
# `none` (default): email-dependent flows return 503; sign-up verification is
# skipped so a no-email self-host still works. `smtp` or `cloudflare` enable it.
# MARFA_EMAIL_BACKEND=none
# MARFA_EMAIL_FROM=Marfa <hello@example.com>
# MARFA_EMAIL_REPLY_TO=hello@example.com
#
# SMTP backend — the recommended path for self-hosters. Any provider works;
# Brevo (free 300/day) and a Gmail app-password (free, single user) are easy
# starting points. Port 587 = STARTTLS, 465 = implicit TLS (set SECURE=true).
# MARFA_EMAIL_BACKEND=smtp
# MARFA_SMTP_HOST=smtp-relay.brevo.com
# MARFA_SMTP_PORT=587
# MARFA_SMTP_USER=
# MARFA_SMTP_PASS=
# MARFA_SMTP_SECURE=false
#
# Cloudflare Email Service backend (the hosted-Marfa path; needs a paid plan
# and a CF-verified sender domain).
# MARFA_EMAIL_BACKEND=cloudflare
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_EMAIL_API_TOKEN=

# --- Optional ---
# ENABLE_HSTS=false        # set true only behind TLS
# ERROR_WEBHOOK_URL=       # webhook for 500-error notifications (debounced)
#
# Where this server runs, reported in /health's `placement` block. Absent
# rather than empty when unset. Set them to whatever describes the location;
# nothing here is provider-specific, so the answer keeps working if the
# deployment moves.
# MARFA_PLACEMENT_REGION=
# MARFA_PLACEMENT_LOCATION=
# MARFA_PLACEMENT_COUNTRY=
