# Marfa server: the settings it reads from the environment.
#
# Copy to `.env` and fill in. `conformance/spec/instance.md` defines each
# one's type, bounds and default, and the server refuses to start on a value
# outside them, naming the setting. A blank value counts as unset. Values
# shown are the defaults unless noted.
# These are the start-only settings, the ones the server needs before its
# database opens. Every other setting is stored and changed while the server
# runs.
# A true-or-false setting takes true/false, 1/0, yes/no or on/off, in any
# case, and refuses anything else.

# --- Server ---
# The port the server listens on. Zero lets the operating system assign one.
# MARFA_PORT=8600
# The address the public listener binds to. Unset: IPv6 when available,
# otherwise IPv4.
# MARFA_LISTEN_HOST=
# The most connections the public listener holds open, and the most for one
# caller address.
# MARFA_MAX_CONNECTIONS=1024
# MARFA_MAX_CONNECTIONS_PER_ADDRESS=256

# --- Storage ---
# One SQLite file per instance.
# MARFA_DATABASE_PATH=./data/marfa.db
# The disk store, where every upload lands.
# MARFA_BLOB_PATH=./data/blobs
# The folder the server backs itself up to. It must exist, outside the data
# directory and the blob folder. Set it or S3_BUCKET, not both.
# MARFA_BACKUP_PATH=

# --- Object store ---
# An S3-compatible object store is attached when S3_BUCKET is set.
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# The key prefix the instance keeps everything under in the bucket. Each
# running instance on a bucket needs its own.
# S3_PREFIX=marfa

# --- Enrichment ---
# A folder of OCR language models. It is read-only and may be missing.
# MARFA_ENRICHMENT_TESSDATA_DIR=

# --- Proxies ---
# The proxies whose X-Forwarded-For header the server believes. Empty: the
# header is ignored.
# MARFA_TRUSTED_PROXY_CIDRS=
# A header the platform's edge overwrites with the client address. It takes
# precedence over MARFA_TRUSTED_PROXY_CIDRS.
# MARFA_TRUSTED_PROXY_HEADER=

# --- Secrets ---
# Unset, the server uses the values it generated on first start into
# marfa.secrets. Changing the salt invalidates every API key and app token.
# MARFA_KEY_SALT=
# At least 32 characters.
# MARFA_AUTH_SECRET=

# --- Webhooks ---
# Whether outbound webhooks may reach loopback, private and other non-public
# addresses.
# MARFA_WEBHOOK_ALLOW_PRIVATE_ADDRESSES=false

# --- Reporting ---
# A URL the server posts a notice to when a request fails with a 500 error.
# MARFA_ERROR_WEBHOOK_URL=
# A URL the server requests on a schedule, so that something else can notice
# when the requests stop.
# MARFA_HEARTBEAT_URL=
# OpenTelemetry keeps its own names. Setting the endpoint turns traces and
# logs on, and OTEL_SDK_DISABLED=true turns off traces, logs and exception
# reports together.
# OTEL_SDK_DISABLED=false
# OTEL_SERVICE_NAME=marfa-server
# OTEL_RESOURCE_ATTRIBUTES=   # key=value pairs, such as deployment.environment=staging
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=
# OTEL_EXPORTER_OTLP_LOGS_HEADERS=
# The share of traces exported. A trace that contains an error is exported
# whatever this says.
# MARFA_OTEL_SAMPLE_RATIO=0.05
# PostHog exception reports turn on when both of these are set.
# MARFA_POSTHOG_HOST=
# MARFA_POSTHOG_PROJECT_TOKEN=

# --- Private machine authority ---
# Absolute Unix socket path. Defaults to control/marfa.sock beside
# MARFA_DATABASE_PATH. The server creates the private directory as 0700 and
# the socket as 0600.
# Run `marfa --socket PATH setup open` or `owner recover` as that same account.
# This is independent of the public HTTP URL and takes no API key.
# MARFA_CONTROL_SOCKET=
# Start only the private listener for recovery, without HTTP or background
# jobs. Stop the normal server first.
# MARFA_CONTROL_ONLY=false

# --- Test harness only ---
# Serve the clock and fault routes a conformance run drives on the private
# socket. A server built without the `test-hooks` feature, as a release is,
# refuses to start with this true. Leave it off on any instance that holds
# real data.
# MARFA_TEST_HOOKS=false
# How far ahead of the system clock the server's clock starts. Needs
# MARFA_TEST_HOOKS.
# MARFA_TEST_CLOCK_OFFSET_MS=0
# The contract version the server speaks instead of the build's. Needs
# MARFA_TEST_HOOKS.
# MARFA_TEST_CONTRACT_VERSION=
# Shortens a timing or a batch size the server fixes. Needs MARFA_TEST_HOOKS.
# MARFA_TEST_TUNING=
