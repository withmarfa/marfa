# Server
PORT=8600
STORAGE_DIALECT=sqlite
# STORAGE_DIALECT=pg
# DATABASE_URL=postgres://myme:password@localhost:5432/myme

# Blob storage
BLOB_BACKEND=filesystem
BLOB_PATH=./data/blobs
# MAX_BLOB_SIZE=52428800  # max upload size in bytes; default 50MB; exceeds → 413 blob_too_large
# BLOB_BACKEND=s3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Security
API_KEY_SALT=change-me-to-a-random-string-at-least-32-chars
# CORS_ORIGINS=http://localhost:3000

# Optional
# AUTH_MODE=keys
# ERROR_WEBHOOK_URL=
# ENABLE_HSTS=false

# Email (transactional: forgot-password, magic-link, email-verify).
# Default `none` returns 503 with `email_transport_not_configured` so
# email-dependent flows fail loud rather than silently dead-letter.
# MYME_EMAIL_BACKEND=none
# MYME_EMAIL_FROM=Myme <hello@mail.myme.so>
# MYME_EMAIL_REPLY_TO=hello@example.com

# Cloudflare Email Service backend (required when MYME_EMAIL_BACKEND=cloudflare).
# Sender domain (mail.myme.so) onboarded via the CF dashboard; no programmatic
# onboarding API. Sender-domain check at boot enforces MYME_EMAIL_FROM ends in
# @mail.myme.so. Reuse any CF API token with Email Sending permission on the
# account; no need to mint a dedicated one.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_EMAIL_API_TOKEN=

# SMTP backend (required when MYME_EMAIL_BACKEND=smtp). Self-host fallback;
# operator owns the domain config.
# MYME_SMTP_HOST=
# MYME_SMTP_PORT=587
# MYME_SMTP_USER=
# MYME_SMTP_PASS=
# MYME_SMTP_SECURE=false
