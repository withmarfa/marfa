# Marfa server — example configuration.
#
# Copy to `.env` and fill in. A starter, not the full list — `config.ts` reads
# most of what the server takes, and a few are read where they are used.
# Values shown here are the defaults unless noted.

# --- Server ---
PORT=8600

# --- Database ---
# One SQLite file per instance.
# SQLITE_PATH=./data/marfa.db

# --- Blob storage ---
BLOB_BACKEND=filesystem
BLOB_PATH=./data/blobs
# MAX_BLOB_SIZE=52428800   # max upload size in bytes (default 50MB); over → 413
# For S3 / R2 / MinIO:
# BLOB_BACKEND=s3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=             # custom endpoint for R2 / MinIO; omit for AWS
# S3_FORCE_PATH_STYLE=     # default true when an endpoint is set, which is
#                          # what MinIO needs. Set false for a store that
#                          # presents virtual-hosted URLs. Read only when
#                          # S3_ENDPOINT is set; AWS is always virtual-hosted.

# --- Behind a reverse proxy ---
# By default the peer address is the client address and any forwarded
# header is ignored, because a client can send one itself. Opt in with
# exactly one of these.
# TRUSTED_PROXY_CIDRS=     # comma-separated proxy CIDRs; x-forwarded-for
#                          # is believed only from a peer inside one
# TRUSTED_PROXY_HEADER=    # for a platform whose edge has no pinnable
#                          # address and overwrites one header, e.g.
#                          # x-real-ip. Takes precedence over the CIDRs.
#                          # Never set it where clients can reach the
#                          # process directly: it is then spoofable.

# --- Security (required in production) ---
# Salt for hashing API keys. Generate once with `openssl rand -hex 32`.
# Rotating it invalidates every existing API key.
API_KEY_SALT=change-me-run-openssl-rand-hex-32
# Secret for signing auth session cookies. Generate with `openssl rand -hex 32`.
# Required in production; rotating it invalidates existing sessions/ciphertext.
MARFA_AUTH_SECRET=change-me-run-openssl-rand-hex-32
# Comma-separated browser origins allowed to call the API cross-origin.
# Required if a browser client signs in against this server.
# CORS_ORIGINS=http://localhost:5173

# --- Auth ---
# Public URL clients reach this server at (drives cookie domain + OAuth issuer).
# MARFA_AUTH_BASE_URL=http://localhost:8600

# --- Optional ---
# ENABLE_HSTS=false        # set true only behind TLS
# ERROR_WEBHOOK_URL=       # webhook for 500-error notifications (debounced)
#
# Where this server runs, reported in /health's `placement` block. Absent
# rather than empty when unset. Set them to whatever describes the location;
# nothing here is provider-specific, so the answer keeps working if the
# deployment moves.
# MARFA_PLACEMENT_REGION=
# MARFA_PLACEMENT_LOCATION=
# MARFA_PLACEMENT_COUNTRY=
