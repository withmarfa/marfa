# Server
PORT=8600
STORAGE_DIALECT=sqlite
# STORAGE_DIALECT=pg
# DATABASE_URL=postgres://myme:password@localhost:5432/myme

# Blob storage
BLOB_BACKEND=filesystem
BLOB_PATH=./data/blobs
# MAX_BLOB_SIZE=52428800  # max upload size in bytes; default 50MB; exceeds → 413 blob_too_large
# BLOB_BACKEND=s3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Security
API_KEY_SALT=change-me-to-a-random-string-at-least-32-chars
# CORS_ORIGINS=http://localhost:3000

# Optional
# AUTH_MODE=keys
# ERROR_WEBHOOK_URL=
# ENABLE_HSTS=false
