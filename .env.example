# Marfa server: every setting it reads.
#
# Copy to `.env` and fill in. The settings schema in
# `packages/server/src/config.ts` defines each one's type, bounds and default,
# and the server refuses to start on a value outside them, naming the setting.
# A blank value counts as unset. Values shown are the defaults unless noted.
# A wait, a timeout or a polling interval takes at most 2147483647 ms, the
# longest delay a Node.js timer supports.
# A true-or-false setting takes true/false, 1/0, yes/no or on/off, in any
# case, and refuses anything else.

# --- Server ---
# `production` turns on the production checks below: the two secrets must be
# set, strong and not a placeholder, and MARFA_AUTH_BASE_URL must be set. The
# image sets it; a server run by hand is in development unless told.
# NODE_ENV=development       # production, development or test
# PORT=8600
# MARFA_LISTEN_HOST=          # unset: unspecified IPv6 address, otherwise IPv4

# --- Database ---
# One SQLite file per instance.
# SQLITE_PATH=./data/marfa.db
# How long a write refused with SQLITE_BUSY is retried before it answers
# 503 write_contention, ms.
# SQLITE_BUSY_BUDGET_MS=5000

# --- Request bodies ---
# MARFA_MAX_REQUEST_BYTES=1048576
# MARFA_MAX_BULK_REQUEST_BYTES=16777216

# --- Blob stores ---
# The disk store is always present: every upload lands here, uploads have no
# size cap, and the folder holds the store's own marker beside the bytes.
# BLOB_PATH=./data/blobs
# The free space uploads, restores, and archive exports must leave, including
# an export's temporary files. A request that would consume the reserve
# returns 507 insufficient_storage, so the database keeps room to write.
# At 0 nothing is held back.
# MARFA_DISK_RESERVE_BYTES=134217728
# A restore or blob upload has no total time limit; the server ends one that receives no bytes for this long.
# MARFA_UPLOAD_IDLE_TIMEOUT_MS=60000
# An S3-compatible object store is attached when S3_BUCKET is set: a second
# place the bytes live, and the one that signs its own fetch links.
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=             # the store's endpoint URL; omit for AWS
# S3_FORCE_PATH_STYLE=true # false for a store that presents virtual-hosted
#                          # URLs. Read only when S3_ENDPOINT is set; AWS is
#                          # always virtual-hosted.
# S3_PREFIX=blobs          # key prefix inside the bucket, one per instance
# Every S3_* name above also runs the Litestream sidecar in deploy/, which
# streams the database to the same bucket under <S3_PREFIX>/db.
# The rules that keep the bytes (conformance/spec/stores.md): the copies a
# blob keeps at the least, how often replication gives every store its
# copies and how much one run copies, how often the copies are checked and
# how much one run checks, and how long an unreferenced blob stands in the
# orphan report before a later run purges it. Replication and the integrity
# check have no off switch, because a store the configuration names is a
# store whose copies are kept. The cleanup interval at 0 switches the orphan
# sweep off.
# MARFA_BLOB_MIN_COPIES=1
# MARFA_BLOB_READ_IDLE_TIMEOUT_MS=30000
# MARFA_BLOB_REPLICATE_INTERVAL_MS=60000
# MARFA_BLOB_REPLICATE_BATCH=100
# MARFA_BLOB_REPLICATE_BATCH_BYTES=1073741824
# MARFA_BLOB_INTEGRITY_INTERVAL_MS=3600000
# MARFA_BLOB_INTEGRITY_BATCH=500
# MARFA_BLOB_INTEGRITY_BATCH_BYTES=1073741824
# MARFA_BLOB_CLEANUP_INTERVAL_MS=86400000
# MARFA_BLOB_CLEANUP_GRACE_MS=86400000

# --- Text extraction ---
# The server extracts text from uploaded files, and reads images with OCR.
# The OCR engine fetches its language model on first use and keeps it in
# MARFA_ENRICHMENT_TESSDATA_DIR, by default a `tessdata` folder beside
# SQLITE_PATH. Keep that folder on a volume that survives a redeploy, or
# the server fetches the model again after each one.
# MARFA_ENRICHMENT_ENABLED=true
# MARFA_ENRICHMENT_OCR_ENABLED=true
# MARFA_ENRICHMENT_TESSDATA_DIR=./data/tessdata
# MARFA_ENRICHMENT_INTERVAL_MS=30000
# MARFA_ENRICHMENT_BATCH_SIZE=8
# MARFA_ENRICHMENT_ITEM_TIMEOUT_MS=60000
# MARFA_ENRICHMENT_MAX_BLOB_BYTES=20971520
# The most a document may inflate to, all its parts together, and the most
# the JavaScript heap of the process that reads one document may take.
# Extraction runs in a process of its own, so a document past either is
# skipped and never takes the server with it; raising a limit offers the
# skipped documents again. That process also holds the document and what it
# inflates to outside the heap, so size the host for the blob limit, the
# inflated limit and the heap together.
# MARFA_ENRICHMENT_MAX_INFLATED_BYTES=67108864
# MARFA_ENRICHMENT_MAX_MEMORY_BYTES=268435456
# MARFA_ENRICHMENT_MAX_TEXT_CHARS=     # defaults to the validator's string cap
# MARFA_ENRICHMENT_MAX_ATTEMPTS=3

# --- Behind a reverse proxy ---
# By default the peer address is the client address and any forwarded
# header is ignored, because a client can send one itself. Opt in with
# exactly one of these.
# TRUSTED_PROXY_CIDRS=     # comma-separated proxy CIDRs; x-forwarded-for
#                          # is believed only from a peer inside one
# TRUSTED_PROXY_HEADER=    # for a platform whose edge has no pinnable
#                          # address and overwrites one header, e.g.
#                          # x-real-ip. Takes precedence over the CIDRs.
#                          # Never set it where clients can reach the
#                          # process directly: it is then spoofable.

# --- Security (required in production) ---
# Generate each with `openssl rand -hex 32`; production refuses a value that
# is short, predictable or a placeholder. A secret is used exactly as
# written, so whitespace around one (a newline from a file) is refused.
# Values live in the deployment's own secret store, never in this file.
# Salt for hashing API keys. Rotating it invalidates every existing API key.
API_KEY_SALT=
# Signs auth session cookies and keys the blob link. At least 32 characters
# wherever it is set; minted per process outside production when unset.
# Rotating it invalidates existing sessions and blob links.
MARFA_AUTH_SECRET=
# Public URL clients reach this server at (drives cookie domain, OAuth issuer
# and the links the server mints for a blob's bytes). Defaults to
# http://localhost:<PORT> outside production.
# MARFA_AUTH_BASE_URL=http://localhost:8600
# Comma-separated browser origins allowed to call the API cross-origin and
# trusted by the sign-in forms, each a scheme and host with no trailing slash.
# A web page the owner approves needs no entry: its approval allows it.
# CORS_ORIGINS=http://localhost:5173
# A JSON array of consent-screen permission bundles replacing the defaults;
# each entry needs a string id, an array of scopes and a boolean default_on.
# MARFA_PERMISSION_BUNDLES=
# ENABLE_HSTS=false        # set true only behind TLS

# --- Rate limits ---
# Requests per credential to one group of operations in each window (a GET
# may make twice as many outside a group another setting caps), the cap on
# the operations under /keys, and the multiplier for the window keyed on the
# credential alone (0 turns it off).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=1000
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_KEYS_REQUESTS=200
# RATE_LIMIT_AGGREGATE_MULTIPLIER=4
# MARFA_RATE_LIMIT_CLEANUP_INTERVAL_MS=3600000

# --- Connectors ---
# How long a connector's hold on its registration lasts since its last take
# or renewal (`connectors/hold-ttl`), ms; 1000-3600000.
# MARFA_CONNECTOR_HOLD_MS=180000

# --- Inbound webhooks ---
# What bounds the door a sender posts to (conformance/spec/inbound-webhooks.md).
# The rate is per endpoint per RATE_LIMIT_WINDOW_MS, and only while the
# limiter is on; the backlog is a connector's unhandled deliveries.
# MARFA_INBOUND_MAX_BYTES=26214400
# RATE_LIMIT_INBOUND_REQUESTS=600
# MARFA_INBOUND_BACKLOG_DELIVERIES=10000
# MARFA_INBOUND_BACKLOG_BYTES=1073741824
# Retained rows and logical body/UTF-8 metadata bytes, including handled receipts.
# MARFA_INBOUND_RETAINED_DELIVERIES=10000
# MARFA_INBOUND_RETAINED_BYTES=1073741824
# Cleanup cadence: 1-2147483647 milliseconds (native timer limit).
# MARFA_INBOUND_CLEANUP_INTERVAL_MS=60000
# MARFA_INBOUND_IN_FLIGHT_BYTES=104857600
# MARFA_INBOUND_READ_TIMEOUT_MS=30000
# Retention horizons: 0-36500 days; zero disables age expiry.
# MARFA_INBOUND_HANDLED_RETENTION_DAYS=7
# MARFA_INBOUND_PENDING_RETENTION_DAYS=30

# --- MCP endpoint ---
# What bounds a file an MCP tool fetches from a web address to save
# (conformance/spec/mcp.md): its size in bytes, and the time from connecting
# to the last byte.
# MARFA_MCP_FETCH_MAX_BYTES=52428800
# MARFA_MCP_FETCH_TIMEOUT_MS=60000

# --- Housekeeping ---
# The server's own periodic jobs run from one table; `GET /housekeeping`
# lists them. The poll interval is how often the scheduler asks the table
# what is due. A retention of 0 switches its job off where noted.
# MARFA_HOUSEKEEPING_POLL_INTERVAL_MS=1000
# Date-based retention and inactivity settings accept 0 through 36500 days;
# event-log retention accepts 0 through 876000 hours; bulk-action retention
# accepts 0 through 3153600000000 milliseconds. Zero disables expiry.
# AUDIT_RETENTION_DAYS=90
# AUDIT_CLEANUP_INTERVAL_MS=86400000
# MARFA_REVOKED_GRANT_RETENTION_DAYS=90            # 0 switches it off
# MARFA_GRANT_INACTIVITY_DAYS=365                  # 0 switches it off
# MARFA_EVENT_LOG_RETENTION_HOURS=720
# MARFA_EVENT_LOG_CLEANUP_INTERVAL_MS=3600000
# TRASH_RETENTION_DAYS=60                          # 0 switches it off
# TRASH_PURGE_INTERVAL_MS=86400000
# AUTH_SESSION_CLEANUP_INTERVAL_MS=3600000
# MARFA_DCR_CLIENT_RETENTION_DAYS=1                # 0 switches it off
# MARFA_DCR_CLIENT_CLEANUP_INTERVAL_MS=3600000
# MARFA_BULK_ACTION_JOB_RETENTION_MS=604800000     # 0 switches it off
# MARFA_BULK_ACTION_JOB_GC_INTERVAL_MS=3600000

# --- Version history ---
# Every version is kept for the recent window, the latest per day for the
# daily window, the latest per week for the weekly window, and none older,
# up to the cap per item; the latest version is always kept.
# VERSION_RECENT_DAYS=30
# VERSION_DAILY_SNAPSHOT_DAYS=90
# VERSION_WEEKLY_SNAPSHOT_DAYS=365
# VERSION_MAX_VERSIONS=500
# VERSION_THINNING_INTERVAL_MS=3600000

# --- Feed expiry ---
# A type's retention_policy sets how many days its feed items stay before the
# job moves them to the trash. The job runs at this interval.
# FEED_EXPIRY_INTERVAL_MS=3600000

# --- Bulk actions and live streams ---
# The bulk-action worker polls at the interval, backing off by the multiplier
# toward the ceiling while idle.
# MARFA_BULK_ACTION_POLL_INTERVAL_MS=500
# MARFA_BULK_ACTION_POLL_MAX_INTERVAL_MS=60000
# MARFA_BULK_ACTION_POLL_BACKOFF_MULTIPLIER=2
# MARFA_SSE_MAX_VIEWERS=0  # concurrent event-stream viewers; 0 is uncapped

# --- Alerts and liveness ---
# ERROR_WEBHOOK_URL=       # webhook for 500-error notifications (debounced)
# MARFA_WEBHOOK_ALLOW_PRIVATE_ADDRESSES=false  # true lets outbound webhooks
#                          # reach loopback and private addresses
# MARFA_ERROR_WEBHOOK_TIMEOUT_MS=5000
# MARFA_HEARTBEAT_URL=     # pinged on a cadence so something elsewhere
#                          # notices when the pings stop
# MARFA_HEARTBEAT_INTERVAL_MS=60000
#
# Where this server runs, reported in /health's `placement` block. Absent
# rather than empty when unset. Set them to whatever describes the location;
# nothing here is provider-specific, so the answer keeps working if the
# deployment moves.
# MARFA_PLACEMENT_REGION=
# MARFA_PLACEMENT_LOCATION=
# MARFA_PLACEMENT_COUNTRY=

# --- Telemetry ---
# Off unless OTEL_EXPORTER_OTLP_ENDPOINT is set, and that one setting is the
# whole switch. Set, the server exports traces (with a span for each storage
# call below the HTTP span) and logs to it; unset, nothing is exported and the
# telemetry SDK is not loaded. The endpoint is a base: traces post to /v1/traces
# and logs to /v1/logs under it, while a signal's own endpoint is used as
# written and needs the general one set too. Each signal takes the general
# headers, overridden by its own. Headers are comma-separated key=value pairs
# whose values are percent-decoded, so a space is written %20
# (Authorization=Bearer%20<token>). Exported logs, traces and exceptions name
# their deployment environment `production`, as does the error notification,
# and the instance by its id as service.instance.id. OTEL_RESOURCE_ATTRIBUTES
# replaces any attribute the server names, deployment.environment among them,
# and OTEL_SERVICE_NAME takes precedence over a service.name it holds.
# Exceptions reach PostHog's error tracking, which OTLP does not feed, only
# through MARFA_POSTHOG_HOST and MARFA_POSTHOG_PROJECT_TOKEN, set together and
# only while the endpoint is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# OTEL_EXPORTER_OTLP_LOGS_HEADERS=
# OTEL_SERVICE_NAME=marfa-server
# OTEL_RESOURCE_ATTRIBUTES=   # key=value pairs, such as deployment.environment=staging
# MARFA_OTEL_SAMPLE_RATIO=0.05
# MARFA_POSTHOG_HOST=
# MARFA_POSTHOG_PROJECT_TOKEN=

# --- Private machine authority ---
# Absolute normalized Unix socket path, with no symlink components (max 103 bytes).
# Defaults to control/marfa.sock beside SQLITE_PATH; the image uses the path below.
# The server creates the private directory as 0700 and socket as 0600.
# Existing directories must belong to the server account and pass ownership/ACL checks.
# Linux requires getfacl from the acl package; the container includes it.
# Run `marfa --socket PATH setup open` or `owner recover` as that same account.
# This is independent of the public HTTP URL and takes no API key.
# MARFA_CONTROL_SOCKET=/data/control/marfa.sock
# Start only the private listener for recovery, without HTTP or background jobs.
# Use the existing database and secrets; stop the normal server first.
# MARFA_CONTROL_ONLY=false
# Test harness only. Serve the clock and fault routes a conformance run drives
# on the private socket. The server refuses to start with this true when
# NODE_ENV is production. Leave it off on any instance that holds real data.
# MARFA_TEST_HOOKS=false
# How far ahead of the system clock the server's clock starts. Needs
# MARFA_TEST_HOOKS.
# MARFA_TEST_CLOCK_OFFSET_MS=0
# The contract version the server speaks instead of the build's. Needs
# MARFA_TEST_HOOKS.
# MARFA_TEST_CONTRACT_VERSION=
# A failure the update of an earlier schema version meets before it commits:
# hold, lose-row or change-shape. Needs MARFA_TEST_HOOKS.
# MARFA_TEST_MIGRATION_FAULT=
# The free space, in bytes, the update of an earlier schema version takes the
# database's volume to have. Needs MARFA_TEST_HOOKS.
# MARFA_TEST_FREE_DISK_BYTES=

# Live reporting defaults. Receivers and credentials remain machine settings.
# MARFA_ERROR_REPORTING_ENABLED=true
# MARFA_HEARTBEAT_ENABLED=true
