# The server's runtime environment. Copy to `server.env` beside the
# compose file, fill, then `chmod 600 server.env` — this file is the
# deployment's secret store, deliberately: a single root-owned env file on
# a box one operator controls, instead of a secrets manager nothing else
# here would justify.
#
# This example carries the deployment-shape choices and their reasoning.
# The authoritative reference for every variable is the repository root
# AGENTS.md; anything not listed here keeps its documented default.

# ---- Database ---------------------------------------------------------------
DB_DIALECT=pg

# Production: the managed cluster's PRIVATE hostname (reachable only from
# inside the VPC), with TLS required. Staging: the compose-internal
# container, postgres://marfa:<password>@postgres:5432/marfa
DATABASE_URL=

# A direct connection is session mode. MARFA_DATABASE_URL_DIRECT stays
# unset on purpose: the dual pooled-and-direct pair exists for
# transaction-mode poolers, and this deployment does not run one.
MARFA_DB_POOL_MODE=session

# ---- Connection budget ------------------------------------------------------
# The smallest managed tier allows 22 usable backend connections, and the
# web + worker containers share them. MARFA_DB_POOL_SIZE caps each
# process's main pool; the session/streaming pool follows as min(pool, 5),
# and the advisory-lock clients (short-hold job ticks on the streaming
# pool, the process-lifetime election holder on its own single-connection
# client) are deliberately separate pools from main — a lock's connection
# must never come from the pool its critical section queries, or the pool
# deadlocks at its own cap. The compose files set web=3 and worker=2.
# Hard caps by client:
#
#   web:    main 3 + streaming 3 + lock holder 1 + consent 2 + pg-boss 2 + LISTEN 1 = 12
#   worker: main 2 + streaming 2 + lock holder 1 + pg-boss 2 + LISTEN 1             =  8
#
# Absolute worst case 20 against the 22 ceiling; steady state around 8.
# Every pool opens lazily, the streaming pool reserves and releases per
# replay/export/job tick, the lock holder is held only by whichever
# process wins the bridge election, and the consent client is idle
# outside OAuth consent writes. The remaining slack absorbs the migrate
# one-shot during a deploy and an operator psql. Raise the database tier
# before raising these knobs.

# ---- Blobs ------------------------------------------------------------------
BLOB_BACKEND=s3
# S3-compatible object storage in the same region as this box.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Identity and auth ------------------------------------------------------
AUTH_MODE=hosted
# openssl rand -hex 32, each
API_KEY_SALT=
MARFA_AUTH_SECRET=
# The public origin of this deployment, e.g. https://api.example.com
MARFA_AUTH_BASE_URL=

# ---- Integrations -----------------------------------------------------------
# Integrations run in-process; the image bundles the ones it loads.
# Tune MARFA_INTEGRATION_WORKER_THREADS here if a deployment needs it.

# ---- Email ------------------------------------------------------------------
MARFA_EMAIL_BACKEND=cloudflare
MARFA_EMAIL_FROM=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=

# ---- Proxy trust ------------------------------------------------------------
# Caddy fronts the server inside the compose network, so client IPs arrive
# in x-forwarded-for. The compose files pin their network subnets
# (production 172.28.0.0/16, staging 172.29.0.0/16) precisely so this can
# trust exactly those ranges; listing both is harmless because only one
# exists on any box. Unset would log Caddy's IP for every client.
TRUSTED_PROXY_CIDRS=172.28.0.0/16,172.29.0.0/16

# ---- Live updates -------------------------------------------------------------
# A stated viewer ceiling rather than an accident of pool arithmetic; a
# live viewer costs memory and two emitter listeners, not a database
# connection. The listener ceiling must exceed twice the viewer cap.
MARFA_SSE_MAX_VIEWERS=200
MAX_SUBSCRIPTION_LISTENERS=450

# ---- Observability ----------------------------------------------------------
MARFA_OTEL_ENABLED=true
# Which deployment this is. Required whenever telemetry is actually exported,
# and the server refuses to start without it: there is nothing to infer it
# from. NODE_ENV is `production` on every container because that is how the
# image is built, so a fallback to it labelled staging's logs as production.
MARFA_OTEL_ENVIRONMENT=
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# Liveness: a dead-man's-switch receiver polled from outside this box.
MARFA_HEARTBEAT_URL=

# Production only: Node's trust store extended with the managed database's
# CA (see the first-deploy steps; the compose file mounts the box's copy at
# this path). Without it the pg driver refuses the cluster's certificate.
# NODE_EXTRA_CA_CERTS=/app/do-pg-ca.crt
