# Compose-level interpolation values. Copy to `.env` beside the compose
# file on the box. These name the deployment; nothing here is a secret,
# but the filled file still never lands in git.

# Full image reference including tag, e.g.
# registry.example.com/marfa/marfa-server:<sha>
MARFA_SERVER_IMAGE=

# Public hostname Caddy serves and obtains certificates for, e.g.
# api.example.com. DNS for it must already point at this box.
MARFA_API_HOSTNAME=

# Staging compose only: the Postgres container's password.
POSTGRES_PASSWORD=
