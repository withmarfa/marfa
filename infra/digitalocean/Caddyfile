# TLS termination and reverse proxy for the Marfa API.
#
# The hostname comes from the compose-level .env (MARFA_API_HOSTNAME), so
# this file is identical across environments and carries nothing
# deployment-specific. Certificates are ACME-issued and renewed by Caddy;
# the DNS record for the hostname must already point at this box and ports
# 80/443 must be reachable for issuance.
#
# Streaming is load-bearing: live updates are long-lived SSE responses that
# must not be buffered, must not be killed by an idle timeout, and whose
# client disconnects must reach the application. flush_interval -1
# disables response buffering entirely; no timeouts are configured because
# Caddy's defaults do not bound response duration, and adding one here
# would reintroduce the proxy behavior this deployment exists to escape.
{$MARFA_API_HOSTNAME} {
	encode zstd gzip
	reverse_proxy server:8600 {
		flush_interval -1
	}
}
