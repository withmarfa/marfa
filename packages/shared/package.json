{
  "name": "@mymehq/shared",
  "version": "5.1.0",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "tsx scripts/generate-manifest-schema.ts",
    "build": "tsup && node scripts/inline-types-dts.mjs",
    "generate:manifest-schema": "tsx scripts/generate-manifest-schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^4.3.6",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@mymehq/types": "workspace:*",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
