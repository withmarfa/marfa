{
  "name": "@withmarfa/shared",
  "version": "6.7.0",
  "license": "Apache-2.0",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "tsx scripts/generate-manifest-schema.ts",
    "build": "tsup && node scripts/inline-types-dts.mjs",
    "generate:manifest-schema": "tsx scripts/generate-manifest-schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@withmarfa/types": "workspace:*",
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
