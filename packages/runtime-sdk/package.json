{
  "name": "@withmarfa/runtime-sdk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SDK that Connections integrations import. Typed handler API, per-connection state, ConnectionClient (wraps @withmarfa/sdk), echo suppression, system.activity emission.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@withmarfa/sdk": "workspace:*",
    "@withmarfa/shared": "workspace:*",
    "cron-parser": "^5.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260602.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
