{
  "name": "@withmarfa/runtime-sdk",
  "version": "1.1.0",
  "type": "module",
  "description": "SDK that Connections integrations import. Typed handler API, per-connection state, ConnectionClient (wraps @withmarfa/sdk), echo suppression, system.activity emission.",
  "license": "Apache-2.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@withmarfa/shared": "workspace:*",
    "cron-parser": "^5.10.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260821.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
