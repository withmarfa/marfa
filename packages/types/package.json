    "generate": "tsx scripts/generate.ts",
    "shapes:digest": "tsx scripts/shapes-digest.ts --write"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
