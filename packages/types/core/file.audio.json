{
  "id": "core.file.audio",
  "parent": "core.file",
  "label": "Audio",
  "description": "Recordings, music files, voice memos. Inherits all core.file fields.",
  "version": 1,
  "fields": {
    "duration": {
      "type": "number",
      "description": "Length in seconds"
    },
    "language": {
      "type": "string",
      "description": "BCP 47 language code (for spoken content)",
      "format": "bcp47"
    }
  },
  "required": ["duration"],
  "states": ["new", "active", "archived", "trashed"],
  "default_state": "new",
  "transitions": {
    "new": ["active", "archived", "trashed"],
    "active": ["archived", "trashed"],
    "archived": ["active", "trashed"],
    "trashed": ["active"]
  }
}
