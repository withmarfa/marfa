{
  "id": "core.file.image",
  "parent": "core.file",
  "label": "Image",
  "description": "Photos, screenshots, diagrams. Inherits all core.file fields.",
  "version": 1,
  "fields": {
    "width": {
      "type": "integer",
      "description": "Width in pixels"
    },
    "height": {
      "type": "integer",
      "description": "Height in pixels"
    },
    "latitude": {
      "type": "number",
      "description": "Subject latitude"
    },
    "longitude": {
      "type": "number",
      "description": "Subject longitude"
    },
    "altitude": {
      "type": "number",
      "description": "Altitude in meters"
    }
  },
  "required": ["width", "height"],
  "states": ["new", "active", "archived", "trashed"],
  "default_state": "new",
  "transitions": {
    "new": ["active", "archived", "trashed"],
    "active": ["archived", "trashed"],
    "archived": ["active", "trashed"],
    "trashed": ["active"]
  }
}
