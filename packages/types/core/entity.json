{
  "id": "core.entity",
  "label": "Entity",
  "description": "Any named entity: a person, a company, a band, a team, a charity, a brand, a school or a place. `core.entity.person` and `core.entity.place` narrow it.",
  "version": 0,
  "fields": {
    "name": {
      "type": "string",
      "description": "Display name"
    },
    "url": {
      "type": "string",
      "description": "Web address",
      "format": "url"
    },
    "description": {
      "type": "string",
      "description": "What the entity is"
    },
    "email": {
      "type": "string",
      "description": "Contact email",
      "format": "email"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone (E.164 recommended)"
    },
    "place": {
      "type": "string",
      "description": "Location (human-readable address)"
    },
    "image_url": {
      "type": "string",
      "description": "Logo or brand image",
      "format": "url"
    },
    "legal_name": {
      "type": "string",
      "description": "Official registered name"
    },
    "founded": {
      "type": "string",
      "description": "Founding date (ISO 8601)",
      "format": "date"
    },
    "notes": {
      "type": "string",
      "description": "Personal annotations"
    }
  },
  "required": ["name"],
  "display_hints": {
    "title_field": "name",
    "icon": "shapes"
  },
  "merge_policy": {
    "default": "last_writer_wins"
  }
}
