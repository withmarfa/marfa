{
  "id": "core.entity",
  "label": "Entity",
  "description": "Any named entity: a person, a company, a band, a team, a charity, a brand, a school or a place. `core.entity.person` and `core.entity.place` narrow it.",
  "version": 0,
  "fields": {
    "name": {
      "type": "string",
      "description": "Display name"
    },
    "url": {
      "type": "string",
      "label": "URL",
      "description": "Web address",
      "format": "url"
    },
    "description": {
      "type": "string",
      "description": "What the entity is"
    },
    "emails": {
      "type": "array",
      "items_type": "object",
      "description": "Email addresses. The first entry is the main one, and an entry's label is free text, such as work or home.",
      "items_fields": {
        "value": {
          "type": "email",
          "label": "Email",
          "description": "The email address",
          "required": true
        },
        "label": {
          "type": "string",
          "description": "What the entry is for, such as work or home"
        }
      }
    },
    "phones": {
      "type": "array",
      "label": "Phone Numbers",
      "items_type": "object",
      "description": "Phone numbers. The first entry is the main one, and an entry's label is free text, such as work or home.",
      "items_fields": {
        "value": {
          "type": "string",
          "label": "Number",
          "format": "phone",
          "description": "The phone number, in E.164 form where known",
          "required": true
        },
        "label": {
          "type": "string",
          "description": "What the entry is for, such as work or home"
        }
      }
    },
    "addresses": {
      "type": "array",
      "items_type": "object",
      "description": "Postal addresses. The first entry is the main one, and an entry's label is free text, such as work or home.",
      "items_fields": {
        "label": {
          "type": "string",
          "description": "What the entry is for, such as work or home"
        },
        "street_address": {
          "type": "string",
          "description": "Street line"
        },
        "locality": {
          "type": "string",
          "description": "City or town"
        },
        "region": {
          "type": "string",
          "description": "State, province, or county"
        },
        "postal_code": {
          "type": "string",
          "description": "Postcode or ZIP code"
        },
        "country": {
          "type": "string",
          "description": "Country name or code"
        }
      }
    },
    "image_url": {
      "type": "string",
      "label": "Image URL",
      "description": "Logo or brand image",
      "format": "url"
    },
    "legal_name": {
      "type": "string",
      "description": "Official registered name"
    },
    "founded": {
      "type": "string",
      "description": "Founding date (ISO 8601)",
      "format": "date"
    },
    "notes": {
      "type": "string",
      "description": "Personal annotations"
    }
  },
  "required": [
    "name"
  ],
  "display_hints": {
    "title_field": "name",
    "icon": "lucide:shapes"
  },
  "merge_policy": {
    "default": "last_writer_wins"
  }
}
