{
  "id": "core.note",
  "label": "Note",
  "description": "Text you wrote, such as a thought, a meeting note or a list.",
  "version": 0,
  "fields": {
    "body": {
      "type": "string",
      "description": "The text of the note."
    },
    "title": {
      "type": "string",
      "description": "The note's heading."
    },
    "language": {
      "type": "string",
      "description": "BCP 47 language code",
      "format": "bcp47"
    },
    "notes": {
      "type": "string",
      "description": "Your own comments, kept apart from the note's text."
    }
  },
  "display_hints": {
    "title_field": "title",
    "body_field": "body",
    "icon": "lucide:sticky-note"
  },
  "merge_policy": {
    "fields": {
      "body": "keep_both_copies",
      "notes": "keep_both_copies"
    },
    "default": "last_writer_wins"
  }
}
