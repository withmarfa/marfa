{
  "id": "core.bookmark",
  "label": "Bookmark",
  "description": "Content you captured from elsewhere — a saved URL, a highlight, an excerpt, a clipped paragraph.",
  "version": 0,
  "fields": {
    "url": {
      "type": "string",
      "label": "URL",
      "description": "The saved URL",
      "format": "url"
    },
    "body": {
      "type": "string",
      "description": "Captured text (a highlight, excerpt, or clipping)"
    },
    "title": {
      "type": "string",
      "description": "Title of the saved content"
    },
    "description": {
      "type": "string",
      "description": "Summary"
    },
    "source_url": {
      "type": "string",
      "label": "Source URL",
      "description": "Where the content was sourced from",
      "format": "url"
    },
    "source_title": {
      "type": "string",
      "description": "Title of the source"
    },
    "author": {
      "type": "string",
      "description": "Who created the original content"
    },
    "published_at": {
      "type": "string",
      "label": "Published",
      "description": "When the original content was published",
      "format": "datetime"
    },
    "image_url": {
      "type": "string",
      "label": "Image URL",
      "description": "Preview image",
      "format": "url"
    },
    "language": {
      "type": "string",
      "description": "BCP 47 language code",
      "format": "bcp47"
    },
    "notes": {
      "type": "string",
      "description": "Personal annotations"
    }
  },
  "required": [],
  "display_hints": {
    "title_field": "title",
    "body_field": "body",
    "icon": "lucide:bookmark"
  },
  "merge_policy": {
    "fields": {
      "body": "keep_both_copies",
      "notes": "keep_both_copies"
    },
    "default": "last_writer_wins"
  }
}
