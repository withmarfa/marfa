{
  "id": "core.message",
  "_deferred": true,
  "label": "Message",
  "description": "A communication — email, chat message, SMS. Deferred post-V0 (email/chat content is most faithfully stored as HTML, which pressures the markdown-universal body rule). Schema preserved for future reactivation; excluded from the active type registry.",
  "version": 1,
  "fields": {
    "body": {
      "type": "string",
      "description": "Message text"
    },
    "sender": {
      "type": "string",
      "description": "Who sent it"
    },
    "recipients": {
      "type": "array",
      "description": "Primary recipients",
      "items_type": "string"
    },
    "subject": {
      "type": "string",
      "description": "Subject line"
    },
    "cc": {
      "type": "array",
      "description": "Carbon copy recipients",
      "items_type": "string"
    },
    "bcc": {
      "type": "array",
      "description": "Blind carbon copy recipients",
      "items_type": "string"
    },
    "format": {
      "type": "enum",
      "description": "How to interpret body",
      "enum_values": ["plaintext", "markdown", "html"]
    },
    "url": {
      "type": "string",
      "description": "Link to the original message",
      "format": "url"
    },
    "notes": {
      "type": "string",
      "description": "Personal annotations"
    }
  },
  "required": ["body"],
  "states": ["new", "active", "archived", "trashed"],
  "default_state": "new",
  "transitions": {
    "new": ["active", "archived", "trashed"],
    "active": ["archived", "trashed"],
    "archived": ["active", "trashed"],
    "trashed": ["active"]
  }
}
