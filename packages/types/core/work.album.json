{
  "id": "core.work.album",
  "parent": "core.work",
  "label": "Album",
  "description": "An album. Inherits all core.work fields.",
  "version": 1,
  "fields": {
    "release_type": {
      "type": "string",
      "description": "Recommended values: album, ep, single"
    },
    "num_tracks": {
      "type": "integer",
      "description": "Total track count"
    }
  },
  "required": [],
  "states": ["new", "active", "archived", "trashed"],
  "default_state": "new",
  "transitions": {
    "new": ["active", "archived", "trashed"],
    "active": ["archived", "trashed"],
    "archived": ["active", "trashed"],
    "trashed": ["active"]
  }
}
