{
  "id": "core.work.podcast",
  "parent": "core.work",
  "label": "Podcast",
  "description": "A podcast episode. Inherits all core.work fields.",
  "version": 1,
  "fields": {
    "episode_number": {
      "type": "integer",
      "description": "Position in the show"
    },
    "season_number": {
      "type": "integer",
      "description": "Which season"
    },
    "duration": {
      "type": "number",
      "description": "Episode length in seconds"
    },
    "episode_type": {
      "type": "string",
      "description": "Recommended values: full, trailer, bonus"
    }
  },
  "required": [],
  "states": ["new", "active", "archived", "trashed"],
  "default_state": "new",
  "transitions": {
    "new": ["active", "archived", "trashed"],
    "active": ["archived", "trashed"],
    "archived": ["active", "trashed"],
    "trashed": ["active"]
  }
}
