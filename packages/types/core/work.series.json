{
  "id": "core.work.series",
  "parent": "core.work",
  "label": "Series",
  "description": "A TV show or series. Inherits all core.work fields.",
  "version": 1,
  "fields": {
    "season_count": {
      "type": "integer",
      "description": "Number of seasons"
    },
    "episode_count": {
      "type": "integer",
      "description": "Total episodes across all seasons"
    },
    "status": {
      "type": "string",
      "description": "Recommended values: ongoing, ended, cancelled"
    },
    "network": {
      "type": "string",
      "description": "Broadcasting network or streaming service"
    }
  },
  "required": [],
  "states": ["new", "active", "archived", "trashed"],
  "default_state": "new",
  "transitions": {
    "new": ["active", "archived", "trashed"],
    "active": ["archived", "trashed"],
    "archived": ["active", "trashed"],
    "trashed": ["active"]
  }
}
