{
  "id": "core.task",
  "label": "Task",
  "description": "Something to be done.",
  "version": 0,
  "fields": {
    "title": {
      "type": "string",
      "description": "What needs doing"
    },
    "description": {
      "type": "string",
      "description": "Brief context"
    },
    "body": {
      "type": "string",
      "description": "Detailed description"
    },
    "due_at": {
      "type": "string",
      "description": "Deadline",
      "format": "datetime"
    },
    "starts_at": {
      "type": "string",
      "description": "When to start",
      "format": "datetime"
    },
    "completed_at": {
      "type": "string",
      "description": "When completed",
      "format": "datetime"
    },
    "status": {
      "type": "status",
      "description": "Where the task stands",
      "status_values": [
        { "value": "not_started", "group": "not_started" },
        { "value": "in_progress", "group": "in_progress" },
        { "value": "completed", "group": "completed" },
        { "value": "canceled", "group": "canceled" }
      ]
    },
    "priority": {
      "type": "enum",
      "description": "Task priority",
      "enum_values": ["low", "medium", "high", "urgent"]
    },
    "place": {
      "type": "string",
      "description": "Location"
    },
    "precision": {
      "type": "enum",
      "description": "Temporal precision",
      "enum_values": ["year", "month", "day", "time"]
    },
    "url": {
      "type": "string",
      "description": "Related link",
      "format": "url"
    },
    "notes": {
      "type": "string",
      "description": "Personal annotations"
    },
    "recurrence": {
      "type": "array",
      "items_type": "string",
      "description": "RFC 5545 recurrence property lines (RRULE, RDATE, EXDATE) for a task that repeats. The series starts at due_at, or at starts_at when the task has no due_at, and advances in UTC because a task has no timezone. The server keeps and checks the rule but does not unfold it: GET /occurrences answers events only. A write is refused when a line cannot be read or is not applied (EXRULE, an RDATE period), when it carries more than one RRULE, more than 40,000 characters in all or more than 1,000 added and removed dates, when the rule names no date that exists after the start, when it produces no occurrence within the bound a read unfolds a rule to, or when the task has neither due_at nor starts_at."
    }
  },
  "required": ["title"],
  "display_hints": {
    "title_field": "title",
    "body_field": "body",
    "icon": "lucide:square-check-big"
  },
  "merge_policy": {
    "fields": {
      "body": "keep_both_copies",
      "notes": "keep_both_copies"
    },
    "default": "last_writer_wins"
  }
}
