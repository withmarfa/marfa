{
  "id": "core.task",
  "label": "Task",
  "description": "Something you need to do, such as booking flights or sending an invoice.",
  "version": 0,
  "fields": {
    "title": {
      "type": "string",
      "description": "What needs doing."
    },
    "description": {
      "type": "string",
      "description": "A line or two of context."
    },
    "body": {
      "type": "string",
      "description": "The full details, as long as you need."
    },
    "due_at": {
      "type": "string",
      "label": "Due",
      "description": "When the task is due.",
      "format": "datetime"
    },
    "starts_at": {
      "type": "string",
      "label": "Starts",
      "description": "When you plan to start the task.",
      "format": "datetime"
    },
    "completed_at": {
      "type": "string",
      "label": "Completed",
      "description": "When you finished the task.",
      "format": "datetime"
    },
    "status": {
      "type": "status",
      "description": "Where the task stands",
      "status_values": [
        { "value": "not_started", "group": "not_started" },
        { "value": "in_progress", "group": "in_progress" },
        { "value": "completed", "group": "completed" },
        { "value": "canceled", "group": "canceled" }
      ]
    },
    "priority": {
      "type": "enum",
      "description": "How important the task is.",
      "enum_values": ["low", "medium", "high", "urgent"]
    },
    "place": {
      "type": "string",
      "description": "Where the task is done."
    },
    "precision": {
      "type": "enum",
      "description": "How much of the task's date is known, such as only the year or the month.",
      "enum_values": ["year", "month", "day", "time"]
    },
    "url": {
      "type": "string",
      "label": "URL",
      "description": "A web page related to the task.",
      "format": "url"
    },
    "assignees": {
      "type": "array",
      "items_type": "object",
      "description": "The people the task is assigned to, one entry each. An entry has a name, an email or both.",
      "items_fields": {
        "name": {
          "type": "string",
          "description": "The assignee's name as the source gives it, such as a login"
        },
        "email": {
          "type": "email",
          "description": "The assignee's email address"
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Your own comments, kept apart from the task's details."
    },
    "recurrence": {
      "type": "array",
      "items_type": "string",
      "description": "RFC 5545 recurrence lines (RRULE, RDATE, EXDATE) that make the task repeat, counted from `due_at` or, without one, from `starts_at`."
    }
  },
  "required": ["title"],
  "display_hints": {
    "title_field": "title",
    "body_field": "body",
    "icon": "lucide:square-check-big"
  },
  "merge_policy": {
    "fields": {
      "body": "keep_both_copies",
      "notes": "keep_both_copies"
    },
    "default": "last_writer_wins"
  }
}
