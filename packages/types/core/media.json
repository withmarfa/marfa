{
  "id": "core.media",
  "label": "Media",
  "plural": "Media",
  "description": "Content produced by someone that the user engages with — a film, podcast, book, article, song, show.",
  "version": 0,
  "fields": {
    "title": {
      "type": "string",
      "description": "Name of the work"
    },
    "body": {
      "type": "string",
      "description": "Text content or description"
    },
    "author": {
      "type": "string",
      "description": "Who created the work"
    },
    "url": {
      "type": "string",
      "label": "URL",
      "description": "Web address",
      "format": "url"
    },
    "description": {
      "type": "string",
      "description": "Summary or blurb"
    },
    "publisher": {
      "type": "string",
      "description": "Who published the work"
    },
    "published_at": {
      "type": "string",
      "label": "Published",
      "description": "When originally published or released",
      "format": "datetime"
    },
    "image_url": {
      "type": "string",
      "label": "Image URL",
      "description": "Cover art, poster, or thumbnail",
      "format": "url"
    },
    "language": {
      "type": "string",
      "description": "BCP 47 language code",
      "format": "bcp47"
    },
    "progress": {
      "type": "status",
      "description": "Where the owner is with the work: want to read, watch, listen to or play it, started, finished, or gave up",
      "status_values": [
        { "value": "planned", "group": "not_started" },
        { "value": "started", "group": "in_progress" },
        { "value": "finished", "group": "completed" },
        { "value": "abandoned", "group": "canceled" }
      ]
    },
    "rating": {
      "type": "integer",
      "description": "The owner's overall view of the work, from 1 (lowest) to 5 (highest)",
      "minimum": 1,
      "maximum": 5
    },
    "notes": {
      "type": "string",
      "description": "Personal annotations"
    },
    "thumbnail": {
      "type": "thumbnail",
      "description": "A small preview of the work, supplied by the writer"
    }
  },
  "required": ["title"],
  "display_hints": {
    "title_field": "title",
    "body_field": "body",
    "icon": "lucide:library-big"
  },
  "merge_policy": {
    "fields": {
      "body": "keep_both_copies",
      "notes": "keep_both_copies"
    },
    "default": "last_writer_wins"
  }
}
