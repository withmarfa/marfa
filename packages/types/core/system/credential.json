{
  "id": "system.credential",
  "label": "Credential",
  "description": "An API key or OAuth approval. Surfaces a Credentials list; carries permissions and last-used time; revocable. Lifecycle is bounded to active/revoked. Has no tier.",
  "version": 1,
  "fields": {
    "label": {
      "type": "string",
      "description": "Human-readable label"
    },
    "kind": {
      "type": "enum",
      "description": "Credential kind",
      "enum_values": ["api_key", "oauth_token"]
    },
    "scopes": {
      "type": "array",
      "description": "Granted scope strings",
      "items_type": "string"
    },
    "last_used_at": {
      "type": "datetime",
      "description": "Most recent use timestamp"
    }
  },
  "required": ["label", "kind"]
}
