{
  "id": "system.connection",
  "label": "Connection",
  "description": "An OAuth client this user has authorized, written when the user approves the client's consent or device sign-in. `kind` is `app`. Lifecycle bounded to active | revoked. Has no tier.",
  "version": 0,
  "fields": {
    "kind": {
      "type": "enum",
      "description": "Discriminator for connection variant",
      "enum_values": [
        "app"
      ]
    },
    "client_id": {
      "type": "string",
      "description": "OAuth client identifier"
    },
    "scopes": {
      "type": "array",
      "items_type": "string",
      "description": "Granted scope strings"
    },
    "status": {
      "type": "enum",
      "description": "Lifecycle status",
      "enum_values": [
        "active",
        "revoked"
      ]
    },
    "granted_at": {
      "type": "datetime",
      "description": "When the grant was approved"
    },
    "last_used_at": {
      "type": "datetime",
      "description": "Most recent successful use of any token issued under this grant"
    },
    "revoked_at": {
      "type": "datetime",
      "description": "When the grant was revoked, if any"
    }
  },
  "required": [
    "kind",
    "status",
    "granted_at"
  ]
}
