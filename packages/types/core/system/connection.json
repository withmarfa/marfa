{
  "id": "system.connection",
  "label": "Connection",
  "description": "An approved relationship — user-app grant today; external-service connector and tenant-share land in workstream 2. Lifecycle bounded to active | revoked. Has no tier.",
  "version": 1,
  "fields": {
    "kind": {
      "type": "enum",
      "description": "Discriminator for connection variant",
      "enum_values": [
        "user-app-grant",
        "external-service-connector",
        "tenant-share"
      ]
    },
    "client_id": {
      "type": "string",
      "description": "OAuth client identifier (for kind: user-app-grant)"
    },
    "scopes": {
      "type": "array",
      "items_type": "string",
      "description": "Granted scope strings"
    },
    "status": {
      "type": "enum",
      "description": "Lifecycle status",
      "enum_values": ["active", "revoked"]
    },
    "granted_at": {
      "type": "datetime",
      "description": "When the grant was approved"
    },
    "last_used_at": {
      "type": "datetime",
      "description": "Most recent successful use of any token issued under this grant"
    },
    "revoked_at": {
      "type": "datetime",
      "description": "When the grant was revoked, if any"
    }
  },
  "required": ["kind", "status", "granted_at"]
}
