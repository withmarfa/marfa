{
  "id": "core.highlight",
  "label": "Highlight",
  "description": "A user's engagement with content — the highlighted passage, its body, plus optional annotation. What was highlighted is linked with an `excerpt-of` edge, not `references`, and names the highlight, which has no title of its own; the moment of highlighting is the item's own `occurred_at`.",
  "version": 0,
  "fields": {
    "text": {
      "type": "string",
      "description": "The highlighted passage, as Markdown"
    },
    "note": {
      "type": "string",
      "description": "User annotation on the highlight"
    },
    "color": {
      "type": "enum",
      "description": "Highlight color",
      "enum_values": ["yellow", "blue", "green", "pink", "orange", "purple"]
    },
    "locator_type": {
      "type": "enum",
      "description": "How start_location / end_location are interpreted",
      "enum_values": ["offset", "page", "time", "cfi", "order", "none"]
    },
    "start_location": {
      "type": "string",
      "description": "Start locator, typed by locator_type"
    },
    "end_location": {
      "type": "string",
      "description": "End locator, typed by locator_type"
    }
  },
  "required": ["text"],
  "display_hints": {
    "body_field": "text",
    "name_from_body": false,
    "icon": "lucide:highlighter"
  },
  "merge_policy": {
    "fields": {
      "note": "keep_both_copies"
    },
    "default": "last_writer_wins"
  }
}
