{
  "id": "core.highlight",
  "label": "Highlight",
  "description": "A passage you highlighted, with your note on it.",
  "version": 0,
  "fields": {
    "text": {
      "type": "string",
      "description": "The highlighted passage, as Markdown."
    },
    "note": {
      "type": "string",
      "description": "Your note on the passage."
    },
    "color": {
      "type": "enum",
      "description": "The color of the highlight.",
      "enum_values": ["yellow", "blue", "green", "pink", "orange", "purple"]
    },
    "locator_type": {
      "type": "enum",
      "description": "How to read start_location and end_location: offset, page, time, cfi, order or none.",
      "enum_values": ["offset", "page", "time", "cfi", "order", "none"]
    },
    "start_location": {
      "type": "string",
      "description": "Where the highlight starts, read as locator_type says."
    },
    "end_location": {
      "type": "string",
      "description": "Where the highlight ends, read as locator_type says."
    }
  },
  "required": ["text"],
  "display_hints": {
    "body_field": "text",
    "name_from_body": false,
    "icon": "lucide:highlighter"
  },
  "merge_policy": {
    "fields": {
      "note": "keep_both_copies"
    },
    "default": "last_writer_wins"
  }
}
