{
  "id": "core.collection",
  "label": "Collection",
  "description": "A named group of items.",
  "version": 1,
  "fields": {
    "title": {
      "type": "string",
      "description": "Collection name"
    },
    "description": {
      "type": "string",
      "description": "What this collection is"
    },
    "body": {
      "type": "string",
      "description": "Longer description"
    },
    "format": {
      "type": "enum",
      "description": "How to interpret body",
      "enum_values": ["plaintext", "markdown", "html"]
    },
    "image_url": {
      "type": "string",
      "description": "Cover image",
      "format": "url"
    },
    "notes": {
      "type": "string",
      "description": "Personal annotations"
    }
  },
  "required": ["title"],
  "states": ["new", "active", "archived", "trashed"],
  "default_state": "active",
  "transitions": {
    "new": ["active", "archived", "trashed"],
    "active": ["archived", "trashed"],
    "archived": ["active", "trashed"],
    "trashed": ["active"]
  }
}
