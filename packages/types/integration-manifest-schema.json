{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "type": "string",
      "enum": [
        "read",
        "write",
        "both"
      ]
    },
    "runs_on": {
      "default": "server",
      "type": "string",
      "enum": [
        "server",
        "client"
      ]
    },
    "triggers": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "schedule"
              },
              "config": {
                "type": "object",
                "properties": {
                  "cron": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "cron"
                ]
              }
            },
            "required": [
              "type",
              "config"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "webhook"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "item-event"
              }
            },
            "required": [
              "type"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "manual"
              }
            },
            "required": [
              "type"
            ]
          }
        ]
      }
    },
    "target_types": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bidirectional_handling": {
      "type": "object",
      "properties": {
        "echo_ttl_seconds": {
          "default": 60,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "lag_window_seconds": {
          "default": 60,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "tombstone_mapping": {
          "type": "string",
          "enum": [
            "state-trashed",
            "prompt-user",
            "ignore"
          ]
        },
        "partial_write_mode": {
          "type": "string",
          "enum": [
            "all-or-nothing",
            "accept-partial"
          ]
        }
      },
      "required": [
        "tombstone_mapping",
        "partial_write_mode"
      ]
    },
    "oauth_requirements": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "enum": [
          "proxy",
          "leased"
        ]
      }
    },
    "token_requirements": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "const": "required"
      }
    },
    "webhook_verification": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "hmac-sha256"
            }
          },
          "required": [
            "method"
          ]
        },
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "slack"
            }
          },
          "required": [
            "method"
          ]
        },
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "stripe"
            }
          },
          "required": [
            "method"
          ]
        },
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "github"
            }
          },
          "required": [
            "method"
          ]
        },
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "google-channel"
            }
          },
          "required": [
            "method"
          ]
        },
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "cloudflare-email"
            }
          },
          "required": [
            "method"
          ]
        }
      ]
    },
    "manifest_schema_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "permissions": {
      "type": "object",
      "properties": {
        "extension": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ]
          }
        },
        "edge": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ]
          }
        }
      }
    },
    "configuration_schema": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean",
              "string_array"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "values": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "from_target_types": {
            "type": "boolean"
          },
          "from_write_families": {
            "type": "boolean"
          },
          "default": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "required": [
          "type",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "write_families": {
      "type": "object",
      "properties": {
        "families": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "types": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "description",
              "types"
            ],
            "additionalProperties": false
          }
        },
        "default": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "families",
        "default"
      ],
      "additionalProperties": false
    },
    "supports_user_mappings": {
      "type": "boolean"
    },
    "type_schemas": {
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "name",
    "version",
    "publisher",
    "description",
    "direction",
    "target_types",
    "manifest_schema_version"
  ],
  "additionalProperties": false
}
