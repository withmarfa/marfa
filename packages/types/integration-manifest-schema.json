{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "type": "string",
      "enum": [
        "read",
        "write",
        "both"
      ]
    },
    "triggers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "schedule"
              },
              "config": {
                "type": "object",
                "properties": {
                  "cron": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "cron"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "config"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "webhook"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "item-event"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "manual"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "target_types": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtime_compatibility": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "hosted",
          "self-hosted",
          "local"
        ]
      }
    },
    "bidirectional_handling": {
      "type": "object",
      "properties": {
        "echo_ttl_seconds": {
          "default": 60,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "lag_window_seconds": {
          "default": 60,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "tombstone_mapping": {
          "type": "string",
          "enum": [
            "state-trashed",
            "prompt-user",
            "ignore"
          ]
        },
        "partial_write_mode": {
          "type": "string",
          "enum": [
            "all-or-nothing",
            "accept-partial"
          ]
        }
      },
      "required": [
        "echo_ttl_seconds",
        "lag_window_seconds",
        "tombstone_mapping",
        "partial_write_mode"
      ],
      "additionalProperties": false
    },
    "oauth_requirements": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "enum": [
          "proxy",
          "leased"
        ]
      }
    },
    "token_requirements": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "const": "required"
      }
    },
    "webhook_verification": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "hmac-sha256"
            }
          },
          "required": [
            "method"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "slack"
            }
          },
          "required": [
            "method"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "stripe"
            }
          },
          "required": [
            "method"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "github"
            }
          },
          "required": [
            "method"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "google-channel"
            }
          },
          "required": [
            "method"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "cloudflare-email"
            }
          },
          "required": [
            "method"
          ],
          "additionalProperties": false
        }
      ]
    },
    "manifest_schema_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "permissions": {
      "type": "object",
      "properties": {
        "extension": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ]
          }
        },
        "edge": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "version",
    "publisher",
    "description",
    "direction",
    "triggers",
    "target_types",
    "runtime_compatibility",
    "bidirectional_handling",
    "oauth_requirements",
    "webhook_verification",
    "manifest_schema_version"
  ],
  "additionalProperties": false
}
