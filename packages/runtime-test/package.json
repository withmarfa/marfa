{
  "name": "@withmarfa/runtime-test",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "In-memory mocks of the runtime's dispatch primitives (per-connection storage, the queue) plus a createTestHarness helper, so Connections integrations can unit-test their handlers without booting the server.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@withmarfa/runtime-sdk": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260821.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
