{
  "name": "@withmarfa/server",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx --import ./src/instrumentation.ts watch src/index.ts",
    "migrate": "tsx src/storage/migrate.ts",
    "migrate:oauth-to-credential": "tsx src/scripts/deprecated/migrate-oauth-to-credential.ts",
    "migrate:sync-json-to-connection": "tsx src/scripts/deprecated/migrate-sync-json-to-connection.ts",
    "migrate:pg:generate": "drizzle-kit generate --config=drizzle.pg.config.ts && pnpm run schema-sql:generate:pg",
    "migrate:sqlite:generate": "drizzle-kit generate --config=drizzle.sqlite.config.ts && pnpm run schema-sql:generate:sqlite",
    "schema-sql:generate": "pnpm run schema-sql:generate:sqlite && pnpm run schema-sql:generate:pg",
    "schema-sql:generate:sqlite": "tsx scripts/generate-schema-sql.ts --dialect=sqlite",
    "schema-sql:generate:pg": "bash scripts/with-temp-pg.sh tsx scripts/generate-schema-sql.ts --dialect=pg",
    "lint:sqlite-migrations": "tsx scripts/lint-sqlite-migrations.ts",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "smoke:worker-entry": "tsx scripts/smoke-worker-entry.ts",
    "auth:gallery": "tsx scripts/auth-gallery.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1058.0",
    "@aws-sdk/s3-request-presigner": "^3.1058.0",
    "@better-auth/oauth-provider": "1.6.13",
    "@better-auth/passkey": "1.6.13",
    "@hono/node-server": "^2.0.4",
    "@hono/zod-openapi": "^1.4.0",
    "@libsql/client": "^0.17.3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "^0.218.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/instrumentation": "^0.218.0",
    "@opentelemetry/instrumentation-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-logs": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@withmarfa/runtime-sdk": "workspace:*",
    "@withmarfa/shared": "workspace:*",
    "@withmarfa/webhooks": "workspace:*",
    "better-auth": "1.6.13",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "ipaddr.js": "^2.4.0",
    "jose": "^6.2.3",
    "nodemailer": "^8.0.10",
    "pg-boss": "^12.18.2",
    "postgres": "^3.4.9",
    "tar-stream": "^3.2.0",
    "tslib": "^2.8.1",
    "undici": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/tar-stream": "^3.1.4",
    "@withmarfa/integration-sync": "workspace:*",
    "@withmarfa/runtime-test": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
