{
  "name": "@mymehq/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx src/storage/migrate.ts",
    "migrate:oauth-to-credential": "tsx src/scripts/migrate-oauth-to-credential.ts",
    "migrate:pg:generate": "drizzle-kit generate --config=drizzle.pg.config.ts",
    "migrate:sqlite:generate": "drizzle-kit generate --config=drizzle.sqlite.config.ts",
    "generate:openapi": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1021.0",
    "@aws-sdk/s3-request-presigner": "^3.1021.0",
    "@better-auth/passkey": "1.6.9",
    "@hono/node-server": "^1.13.8",
    "@hono/zod-openapi": "^1.2.4",
    "@mymehq/shared": "workspace:*",
    "better-auth": "1.6.9",
    "better-sqlite3": "^12.9.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.5",
    "ipaddr.js": "^2.3.0",
    "postgres": "^3.4.8",
    "tar-stream": "^3.1.8",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@mymehq/runtime-sdk": "workspace:*",
    "@mymehq/runtime-test": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/tar-stream": "^3.1.4",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.5.1",
    "tsx": "^4.19.4",
    "typescript": "^6.0.2"
  }
}
