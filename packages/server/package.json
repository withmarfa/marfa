{
  "name": "@withmarfa/server",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx watch --import ./src/instrumentation.ts src/index.ts",
    "migrate": "tsx src/storage/migrate.ts",
    "schema-sql:generate": "tsx scripts/generate-schema-sql.ts",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "surface-lock:generate": "tsx scripts/generate-surface-lock.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@aws-sdk/lib-storage": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1113.0",
    "@better-auth/oauth-provider": "1.7.1",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.0",
    "@libsql/client": "^0.17.4",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@withmarfa/shared": "workspace:*",
    "better-auth": "1.7.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "ical.js": "^2.2.1",
    "image-dimensions": "^2.5.1",
    "ipaddr.js": "^2.5.0",
    "music-metadata": "^11.15.0",
    "officeparser": "^8.0.0",
    "tar-stream": "^3.2.0",
    "tesseract.js": "^7.0.0",
    "tslib": "^2.8.1",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@types/node": "^26.2.0",
    "@types/tar-stream": "^3.1.4",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
