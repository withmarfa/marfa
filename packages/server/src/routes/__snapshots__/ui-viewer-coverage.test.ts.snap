          <h1 class="title">Configure readwise</h1>
      <form method="post" action="/connections/01999a3f-96ad-4ec1-b378-399d4875cfa5/configure">
        <label class="field"><span class="field-name">include_highlights</span><span class="field-desc">Pull highlights as well as the source documents.</span><input type="checkbox" name="include_highlights" value="true" checked></label>
<label class="field"><span class="field-name">since_days</span><span class="field-desc">How far back to look on the first run.</span><input type="number" name="since_days" value="30"></label>
<label class="field"><span class="field-name">target_type</span><span class="field-desc">Which type new items are written as.</span><select name="target_type"><option value="readwise.highlight">readwise.highlight</option><option value="core.highlight">core.highlight</option></select></label>
<label class="field"><span class="field-name">tags</span><span class="field-desc">Tags applied to every item this connection creates.</span><input type="text" name="tags" value="" placeholder="comma-separated"></label>
        <button type="submit" class="btn btn--primary">Save configuration</button>
      </form>
    
  </main>
</body>
