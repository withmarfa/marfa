exports[`every gallery variant renders > renders 'auth/consent/expired' 1`] = `
"<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>This request has expired</title>
  <link rel="stylesheet" href="/auth/static/auth.css">
</head>
<body>
  <main class="card card--confirm" aria-label="This request has expired">
    
    <div class="confirm-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div>
    <h1 class="title">This request has expired</h1>
    <p class="sub" role="alert">Sign-in requests time out after a few minutes. Go back to the app you were signing in to and start again.</p>
  
  </main>
</body>
</html>"
`;

exports[`every gallery variant renders > renders 'auth/consent/first-time' 1`] = `
"<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Authorize Raycast</title>
  <link rel="stylesheet" href="/auth/static/auth.css">
</head>
<body>
  <main class="card" aria-label="Authorize Raycast">
    
    <h1 class="title">Allow access</h1>
    <p class="sub"><b>Raycast</b> wants to access your space. You can change this anytime in settings.</p>
    <div class="callout"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg><span>Marfa hasn't verified this app. Anyone can use this name, so only allow access if you trust it.</span></div>
    
    <form method="POST" action="/auth/authorize/decision" class="consent-form" novalidate>
      <input type="hidden" name="client_id" value="raycast-client">
      <input type="hidden" name="oauth_query" value="client_id=raycast-client&amp;scope=...&amp;sig=signed">
      <div class="t-soft"><details class="grp">
      <summary>
        <span class="gmain">
          <span class="gtop"><span class="glabel">Read your content</span><svg class="gchev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></span>
          <span class="gdesc">Notes, Tasks and Bookmarks.</span>
        </span>
        <label class="sw" onclick="event.stopPropagation()"><input type="checkbox" checked aria-label="Read your content"><span class="tk" aria-hidden="true"></span></label>
      </summary>
      <div class="gsub"><div class="subrow"><span>Notes</span><label class="sw"><input type="checkbox" name="scopes" value="core.note:read" checked><span class="tk" aria-hidden="true"></span></label></div><div class="subrow"><span>Tasks</span><label class="sw"><input type="checkbox" name="scopes" value="core.task:read" checked><span class="tk" aria-hidden="true"></span></label></div><div class="subrow"><span>Bookmarks</span><label class="sw"><input type="checkbox" name="scopes" value="core.bookmark:read" checked><span class="tk" aria-hidden="true"></span></label></div></div>
    </details><details class="grp">
      <summary>
        <span class="gmain">
          <span class="gtop"><span class="glabel">Write your content</span><svg class="gchev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></span>
          <span class="gdesc">Notes and Tasks.</span>
        </span>
        <label class="sw" onclick="event.stopPropagation()"><input type="checkbox" checked aria-label="Write your content"><span class="tk" aria-hidden="true"></span></label>
      </summary>
      <div class="gsub"><div class="subrow"><span>Notes</span><label class="sw"><input type="checkbox" name="scopes" value="core.note:write" checked><span class="tk" aria-hidden="true"></span></label></div><div class="subrow"><span>Tasks</span><label class="sw"><input type="checkbox" name="scopes" value="core.task:write" checked><span class="tk" aria-hidden="true"></span></label></div></div>
    </details><details class="grp">
      <summary>
        <span class="gmain">
          <span class="gtop"><span class="glabel">Your profile</span><svg class="gchev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></span>
          <span class="gdesc">Your name and your email address.</span>
        </span>
        <label class="sw" onclick="event.stopPropagation()"><input type="checkbox" checked aria-label="Your profile"><span class="tk" aria-hidden="true"></span></label>
      </summary>
      <div class="gsub"><div class="subrow"><span>Your name and picture</span><label class="sw"><input type="checkbox" name="scopes" value="profile" checked><span class="tk" aria-hidden="true"></span></label></div><div class="subrow"><span>Your email address</span><label class="sw"><input type="checkbox" name="scopes" value="email" checked><span class="tk" aria-hidden="true"></span></label></div></div>
    </details></div><input type="checkbox" name="scopes" value="openid" checked hidden>
      <div class="actions">
        <button type="submit" name="accept" value="true" class="btn btn--primary" data-loading-label="Allow access...">Allow access</button>
        <button type="submit" name="accept" value="false" class="btn btn--ghost">Deny</button>
      </div>
    </form>
    <script>(function () { document.querySelectorAll('.grp').forEach(function (grp) { var master = grp.querySelector(':scope > summary input[type="checkbox"]'); var members = grp.querySelectorAll('.gsub input[type="checkbox"]'); if (!master || !members.length) return; master.addEventListener('change', function () { members.forEach(function (m) { m.checked = master.checked; }); }); function sync() { var any = false, all = true; members.forEach(function (m) { if (m.checked) any = true; else all = false; }); master.checked = any; master.indeterminate = any && !all; } members.forEach(function (m) { m.addEventListener('change', sync); }); sync(); }); })();</script>
    <script src="/auth/static/submit-state.js"></script>
  
  </main>
</body>
</html>"
`;

