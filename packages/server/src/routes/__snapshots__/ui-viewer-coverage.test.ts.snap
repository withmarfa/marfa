exports[`every gallery variant renders > renders 'auth/keys/create' 1`] = `
"<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>API keys</title>
  <link rel="stylesheet" href="/auth/static/auth.css">
</head>
<body>
  <main class="card card--wide" aria-label="API keys">
    
    <div class="head">
      <h1 class="title">API keys</h1>
      <button type="button" class="iconbtn" id="new-key-btn" aria-label="New key" aria-expanded="false">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      </button>
    </div>

    
    <div data-list-view hidden>
      <p class="sub">Keys let the Marfa API and command line act on your behalf. Signed in as <strong>jonah@example.com</strong>.</p>
      
      <div class="row">
              <div class="row__main">
                <div class="row__title">Personal laptop</div>
                <div class="row__meta">Added 10 May 2026</div>
                <div class="row__meta row__meta--faint">Last used 18 Jun 2026</div>
              </div>
              <form method="POST" action="/auth/keys/key-1/revoke" class="row__action">
                <button type="submit" class="btn btn--outline btn--sm">Revoke</button>
              </form>
            </div>
    </div>
  
    
    <div id="create-panel" data-create-view data-start-open="1">
      <p class="sub">Name your key and choose what it can reach.</p>
      <form method="POST" action="/auth/keys" class="form" data-key-form novalidate>
        <label class="field">
          <span class="field__label">Label</span>
          <input type="text" name="label" required maxlength="200" placeholder="e.g. Laptop CLI" autocomplete="off">
          <span class="field__hint">Name it so you can recognize it later.</span>
        </label>
        <div>
          <p class="lsec" style="margin-top:2px">What content can this key reach?</p>
          <p class="field__hint" style="margin:0 0 10px">A key acts on your behalf over the content you pick. Your profile and account stay private.</p>
          <div class="t-soft">
            <details class="grp">
    <summary>
      <span class="gmain">
        <span class="gtop"><span class="glabel">Read your content</span><svg class="gchev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></span>
        <span class="gdesc">Your notes, tasks, bookmarks, and more.</span>
      </span>
      <label class="sw" onclick="event.stopPropagation()"><input type="checkbox" data-master="read" checked aria-label="Read your content"><span class="tk"></span></label>
    </summary>
    <div class="gsub"><div class="subrow"><span>Notes</span><label class="sw"><input type="checkbox" name="scopes" value="core.note:read" data-group="read" checked><span class="tk"></span></label></div><div class="subrow"><span>Messages</span><label class="sw"><input type="checkbox" name="scopes" value="core.message:read" data-group="read" checked><span class="tk"></span></label></div><div class="subrow"><span>Tasks</span><label class="sw"><input type="checkbox" name="scopes" value="core.task:read" data-group="read" checked><span class="tk"></span></label></div><div class="subrow"><span>Bookmarks</span><label class="sw"><input type="checkbox" name="scopes" value="core.bookmark:read" data-group="read" checked><span class="tk"></span></label></div><div class="subrow"><span>Highlights</span><label class="sw"><input type="checkbox" name="scopes" value="core.highlight:read" data-group="read" checked><span class="tk"></span></label></div><div class="subrow"><span>Calendar</span><label class="sw"><input type="checkbox" name="scopes" value="core.event:read" data-group="read" checked><span class="tk"></span></label></div><div class="subrow"><span>Contacts</span><label class="sw"><input type="checkbox" name="scopes" value="core.entity.person:read" data-group="read" checked><span class="tk"></span></label></div><div class="subrow"><span>Files</span><label class="sw"><input type="checkbox" name="scopes" value="core.file.*:read" data-group="read" checked><span class="tk"></span></label></div></div>
  </details>
            <details class="grp">
    <summary>
      <span class="gmain">
        <span class="gtop"><span class="glabel">Write your content</span><svg class="gchev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></span>
        <span class="gdesc">Add, edit, and organize what's in your space.</span>
      </span>
      <label class="sw" onclick="event.stopPropagation()"><input type="checkbox" data-master="write" checked aria-label="Write your content"><span class="tk"></span></label>
    </summary>
    <div class="gsub"><div class="subrow"><span>Notes</span><label class="sw"><input type="checkbox" name="scopes" value="core.note:write" data-group="write" checked><span class="tk"></span></label></div><div class="subrow"><span>Messages</span><label class="sw"><input type="checkbox" name="scopes" value="core.message:write" data-group="write" checked><span class="tk"></span></label></div><div class="subrow"><span>Tasks</span><label class="sw"><input type="checkbox" name="scopes" value="core.task:write" data-group="write" checked><span class="tk"></span></label></div><div class="subrow"><span>Bookmarks</span><label class="sw"><input type="checkbox" name="scopes" value="core.bookmark:write" data-group="write" checked><span class="tk"></span></label></div><div class="subrow"><span>Highlights</span><label class="sw"><input type="checkbox" name="scopes" value="core.highlight:write" data-group="write" checked><span class="tk"></span></label></div><div class="subrow"><span>Calendar</span><label class="sw"><input type="checkbox" name="scopes" value="core.event:write" data-group="write" checked><span class="tk"></span></label></div><div class="subrow"><span>Contacts</span><label class="sw"><input type="checkbox" name="scopes" value="core.entity.person:write" data-group="write" checked><span class="tk"></span></label></div><div class="subrow"><span>Files</span><label class="sw"><input type="checkbox" name="scopes" value="core.file.*:write" data-group="write" checked><span class="tk"></span></label></div></div>
  </details>
          </div>
        </div>
        <div>
          <p class="lsec" style="margin-top:2px">Everything in your space</p>
          <p class="field__hint" style="margin:0 0 10px">For moving a whole space in or out: importing an existing library, migrating between instances, or restoring a backup. Covers every kind of content and every connection between them, including any added later. Leave it off for a key you are giving to an app.</p>
          <div class="t-soft">
            <div class="subrow">
              <span>Full access</span>
              <label class="sw"><input type="checkbox" name="full_access"><span class="tk"></span></label>
            </div>
          </div>
        </div>
        <div class="actions">
          <button type="submit" class="btn btn--primary" data-create data-loading-label="Creating key...">Create key</button>
          <button type="button" class="btn btn--ghost" data-cancel>Cancel</button>
        </div>
      </form>
    </div>
  

    <script src="/auth/static/submit-state.js"></script>
    <script>(function () { var openBtn = document.getElementById('new-key-btn'); var listView = document.querySelector('[data-list-view]'); var createView = document.querySelector('[data-create-view]'); var form = createView ? createView.querySelector('[data-key-form]') : null; if (!openBtn || !listView || !createView || !form) return; function setCreating(on) { listView.hidden = on; createView.hidden = !on; openBtn.setAttribute('aria-expanded', on ? 'true' : 'false'); if (on) { var f = form.querySelector('input'); if (f) f.focus(); } } openBtn.addEventListener('click', function () { setCreating(createView.hidden); }); var cancel = form.querySelector('[data-cancel]'); if (cancel) cancel.addEventListener('click', function () { setCreating(false); }); form.querySelectorAll('[data-master]').forEach(function (master) { var id = master.getAttribute('data-master'); var members = form.querySelectorAll('input[data-group="' + id + '"]'); master.addEventListener('change', function () { members.forEach(function (m) { m.checked = master.checked; }); }); function sync() { var any = false, all = true; members.forEach(function (m) { if (m.checked) any = true; else all = false; }); master.checked = any; master.indeterminate = any && !all; } members.forEach(function (m) { m.addEventListener('change', sync); }); sync(); }); setCreating(createView.getAttribute('data-start-open') === '1'); })();</script>
  
  </main>
</body>
</html>"
`;

