      <div class="captile__d">Brought into your space.</div>
    </div>

    <details class="disclosure">
      <summary><span class="disclosure__chevron" aria-hidden="true"></span> Details</summary>
      <div class="disclosure__body">
        <p class="disclosure__micro">Kind of content</p>
        <div class="codefield">google.calendar.event</div>
        <p class="disclosure__micro">Permissions</p>
        <div class="codefield">google.calendar.event:write</div>
        <p class="disclosure__micro">Direction</p>
        <div class="codefield">Brings content in. It reads from the other service and writes what it finds into your space.</div>
        
        
      </div>
    </details>

    
    <div class="banner banner--error" role="alert">&quot;feed_url&quot; is required</div>

    <form method="POST" action="/integrations/01999a3f-0000-4ec1-b378-000000000002/install">
      
      <p class="lsec" style="margin-top:16px">Configuration</p><label class="field"><span class="field-name">feed_url *</span><span class="field-desc">The Atom or RSS feed to poll.</span><input type="text" name="config_feed_url" value="" required></label>
      <div class="actions">
        <button type="submit" name="decision" value="approve" class="btn btn--primary">Install</button>
        <button type="submit" name="decision" value="deny" class="btn btn--ghost">Cancel</button>
      </div>
    </form>
  
  </main>
</body>
</html>"
`;

