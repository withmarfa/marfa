}</style></head><body class="m-canvas" style="margin:0;padding:0;background:#f5f5f5;color:#0a0a0a;font-family:-apple-system,BlinkMacSystemFont,&#x27;Segoe UI&#x27;,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.6;-webkit-font-smoothing:antialiased"><div style="display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all">Here&#x27;s your one-time sign-in link. It works once and expires in 5 minutes.</div><table role="presentation" class="m-canvas" cellPadding="0" cellSpacing="0" border="0" width="100%" style="background:#f5f5f5;padding:40px 16px"><tbody><tr><td align="center"><table role="presentation" cellPadding="0" cellSpacing="0" border="0" style="max-width:600px;width:100%"><tbody><tr><td class="m-card" style="background:#ffffff;border-radius:10px;padding:36px"><div class="m-wordmark" style="font-size:16px;font-weight:600;letter-spacing:-0.01em;color:#0a0a0a;line-height:1">Marfa</div><h1 class="m-heading" style="margin:24px 0 0 0;font-size:22px;font-weight:600;letter-spacing:-0.015em;line-height:1.3;color:#0a0a0a">Sign in to Marfa</h1><div style="height:14px;line-height:14px;font-size:0"> </div><p class="m-body" style="margin:0 0 16px 0;color:#3f3f46;font-size:15px;line-height:1.65">Here&#x27;s your one-time sign-in link. It works once and expires in 5 minutes.</p><table role="presentation" cellPadding="0" cellSpacing="0" border="0" style="margin:24px 0 0 0"><tbody><tr><td class="m-btn-cell" style="border-radius:999px;background:#171717"><a class="m-btn" href="https://staging.marfa.so/auth/magic-link?token=preview-magic-token" style="display:inline-block;padding:12px 28px;color:#fafafa;text-decoration:none;font-weight:500;font-size:15px;line-height:20px;border-radius:999px">Sign in</a></td></tr></tbody></table><p class="m-muted" style="margin:18px 0 0 0;color:#71717a;font-size:13px;line-height:1.55">Button not working? <a class="m-link" href="https://staging.marfa.so/auth/magic-link?token=preview-magic-token" style="color:#0a0a0a;font-weight:500;text-decoration:underline">Open the link directly</a>.</p><table role="presentation" cellPadding="0" cellSpacing="0" border="0" width="100%" style="margin:28px 0 0 0"><tbody><tr><td class="m-divider" style="border-top:1px solid #ededed;font-size:0;line-height:0;height:1px"> </td></tr></tbody></table><p class="m-outro" style="margin:18px 0 0 0;color:#71717a;font-size:13px;line-height:1.6">If you didn&#x27;t try to sign in, you can ignore this email. Your account is safe.</p></td></tr><tr><td class="m-footer" style="padding:18px 2px 0 2px;text-align:center;color:#a1a1aa;font-size:12px;line-height:1.5">Sent by Marfa</td></tr></tbody></table></td></tr></tbody></table></body></html>"
`;

exports[`every gallery variant renders > renders 'email/pending-deletion/default' 1`] = `
"<!DOCTYPE html>
<html lang="en"><head><meta charSet="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="color-scheme" content="light dark"/><meta name="supported-color-schemes" content="light dark"/><title>Your Marfa account is scheduled for deletion</title><style>@media (prefers-color-scheme: dark) {
  .m-canvas { background: #050505 !important; }
  .m-card { background: #161616 !important; }
  .m-wordmark, .m-heading { color: #fafafa !important; }
  .m-body { color: #d4d4d8 !important; }
  .m-muted { color: #a1a1aa !important; }
  .m-link { color: #fafafa !important; }
  .m-callout { background: #241312 !important; border-color: #5a2a26 !important; color: #f5b5ad !important; }
  .m-btn-cell { background: #fafafa !important; }
  .m-btn { color: #111111 !important; }
  .m-divider { border-color: #2a2a2a !important; }
  .m-footer, .m-outro { color: #8a8a8a !important; }
}</style></head><body class="m-canvas" style="margin:0;padding:0;background:#f5f5f5;color:#0a0a0a;font-family:-apple-system,BlinkMacSystemFont,&#x27;Segoe UI&#x27;,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.6;-webkit-font-smoothing:antialiased"><div style="display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all">Hi Jonah, your account is scheduled for deletion, as you asked. When the grace period ends, everything in your space is permanently deleted and cannot be recovered.</div><table role="presentation" class="m-canvas" cellPadding="0" cellSpacing="0" border="0" width="100%" style="background:#f5f5f5;padding:40px 16px"><tbody><tr><td align="center"><table role="presentation" cellPadding="0" cellSpacing="0" border="0" style="max-width:600px;width:100%"><tbody><tr><td class="m-card" style="background:#ffffff;border-radius:10px;padding:36px"><div class="m-wordmark" style="font-size:16px;font-weight:600;letter-spacing:-0.01em;color:#0a0a0a;line-height:1">Marfa</div><h1 class="m-heading" style="margin:24px 0 0 0;font-size:22px;font-weight:600;letter-spacing:-0.015em;line-height:1.3;color:#0a0a0a">Account scheduled for deletion</h1><div style="height:14px;line-height:14px;font-size:0"> </div><p class="m-body" style="margin:0 0 16px 0;color:#3f3f46;font-size:15px;line-height:1.65">Hi Jonah, your account is scheduled for deletion, as you asked. When the grace period ends, everything in your space is permanently deleted and cannot be recovered.</p><table role="presentation" cellPadding="0" cellSpacing="0" border="0" width="100%" style="margin:12px 0 20px 0"><tbody><tr><td class="m-callout" style="background:#fef3f2;border:1px solid #fecdca;border-radius:12px;padding:13px 15px;color:#b42318;font-size:14px;line-height:1.5">Your account will be deleted in 30 days, on July 19, 2026.</td></tr></tbody></table><table role="presentation" cellPadding="0" cellSpacing="0" border="0" style="margin:24px 0 0 0"><tbody><tr><td class="m-btn-cell" style="border-radius:999px;background:#171717"><a class="m-btn" href="https://staging.marfa.so/auth/account/cancel?token=preview-cancel-token" style="display:inline-block;padding:12px 28px;color:#fafafa;text-decoration:none;font-weight:500;font-size:15px;line-height:20px;border-radius:999px">Cancel deletion</a></td></tr></tbody></table><p class="m-muted" style="margin:18px 0 0 0;color:#71717a;font-size:13px;line-height:1.55">Button not working? <a class="m-link" href="https://staging.marfa.so/auth/account/cancel?token=preview-cancel-token" style="color:#0a0a0a;font-weight:500;text-decoration:underline">Open the link directly</a>.</p><table role="presentation" cellPadding="0" cellSpacing="0" border="0" width="100%" style="margin:28px 0 0 0"><tbody><tr><td class="m-divider" style="border-top:1px solid #ededed;font-size:0;line-height:0;height:1px"> </td></tr></tbody></table><p class="m-outro" style="margin:18px 0 0 0;color:#71717a;font-size:13px;line-height:1.6">Changed your mind? Cancelling restores everything, and you won&#x27;t need to sign in again.</p></td></tr><tr><td class="m-footer" style="padding:18px 2px 0 2px;text-align:center;color:#a1a1aa;font-size:12px;line-height:1.5">Sent by Marfa</td></tr></tbody></table></td></tr></tbody></table></body></html>"
`;

