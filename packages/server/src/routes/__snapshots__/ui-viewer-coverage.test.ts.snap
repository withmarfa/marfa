exports[`every gallery variant renders > renders 'connections/oauth-callback/error' 1`] = `
"<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>That didn&#39;t finish</title>
  <link rel="stylesheet" href="/auth/static/auth.css">
</head>
<body>
  <main class="card card--confirm" aria-label="That didn&#39;t finish">
    
      <div class="confirm-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div>
      <h1 class="title">That didn't finish</h1>
      <p class="sub" role="alert">The other service turned down the request, or it had already expired. Starting the connection again usually works.</p>
      <details class="disclosure">
        <summary><span class="disclosure__chevron" aria-hidden="true"></span> Details</summary>
        <pre>access_denied: The user denied the request</pre>
      </details>
    
  </main>
</body>
</html>"
`;

