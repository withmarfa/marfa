f="https://staging.marfa.so/auth/account/delete/confirm?token=preview-confirm-token" style="display:inline-block;padding:12px 28px;color:#fafafa;text-decoration:none;font-weight:500;font-size:15px;line-height:20px;border-radius:999px">Confirm deletion</a></td></tr></tbody></table><p class="m-muted" style="margin:18px 0 0 0;color:#71717a;font-size:13px;line-height:1.55">Button not working? <a class="m-link" href="https://staging.marfa.so/auth/account/delete/confirm?token=preview-confirm-token" style="color:#0a0a0a;font-weight:500;text-decoration:underline">Open the link directly</a>.</p><table role="presentation" cellPadding="0" cellSpacing="0" border="0" width="100%" style="margin:28px 0 0 0"><tbody><tr><td class="m-divider" style="border-top:1px solid #ededed;font-size:0;line-height:0;height:1px"> </td></tr></tbody></table><p class="m-outro" style="margin:18px 0 0 0;color:#71717a;font-size:13px;line-height:1.6">If you didn&#x27;t ask for this, ignore this email and your account stays active.</p></td></tr><tr><td class="m-footer" style="padding:18px 2px 0 2px;text-align:center;color:#a1a1aa;font-size:12px;line-height:1.5">Sent by Marfa</td></tr></tbody></table></td></tr></tbody></table></body></html>"
