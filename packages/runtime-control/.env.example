# Required secrets for the runtime-control Cloudflare Worker (control plane).
# Set via `wrangler secret put <NAME> --env <staging|production> --config
# infra/cloudflare/wrangler.control.toml` after the first deploy.
#
# Non-secret per-environment values (ENVIRONMENT, CLOUDFLARE_ACCOUNT_ID)
# live in the [vars] block of infra/cloudflare/wrangler.control.toml, not here.

# Public URL of the Marfa server the control plane authenticates against
# when minting per-Connection runtime credentials via the lease broker.
MARFA_API_URL=

# Platform broker key — same value as the server-side MARFA_RUNTIME_BROKER_KEY
# env. Authenticates control-plane lease requests against the server.
MARFA_RUNTIME_BROKER_KEY=

# Cloudflare API token with Queues read/write permissions on the marfa
# account. Used for the operator DLQ peek/replay endpoints.
CLOUDFLARE_QUEUES_API_TOKEN=
