{
  "name": "@withmarfa/runtime-control",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker — Connections runtime control plane (inbound webhook router, lease broker, install callbacks).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "wrangler dev --config ../../infra/cloudflare/wrangler.control.toml",
    "deploy": "wrangler deploy --config ../../infra/cloudflare/wrangler.control.toml"
  },
  "dependencies": {
    "@withmarfa/shared": "workspace:*",
    "@withmarfa/webhooks": "workspace:*",
    "hono": "^4.12.23"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260602.1",
    "@types/node": "^25.9.1",
    "smol-toml": "^1.4.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.96.0"
  }
}
