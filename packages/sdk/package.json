{
  "name": "@withmarfa/sdk",
  "version": "3.2.0",
  "license": "Apache-2.0",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./auth/node": {
      "types": "./dist/auth/node/index.d.ts",
      "import": "./dist/auth/node/index.js"
    },
    "./replica": {
      "types": "./dist/replica/index.d.ts",
      "import": "./dist/replica/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@withmarfa/shared": "workspace:^",
    "oauth4webapi": "^3.8.7"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@withmarfa/server": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "@tanstack/db": "^0.8.0"
  },
  "peerDependencies": {
    "@tanstack/db": ">=0.6.17 <0.9.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/db": {
      "optional": true
    }
  }
}
