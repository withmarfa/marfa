{
  "name": "@withmarfa/sdk",
  "version": "4.8.0",
  "license": "Apache-2.0",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./auth/node": {
      "types": "./dist/auth/node/index.d.ts",
      "import": "./dist/auth/node/index.js"
    },
    "./replica": {
      "types": "./dist/replica/index.d.ts",
      "import": "./dist/replica/index.js"
    },
    "./local": {
      "types": "./dist/local/index.d.ts",
      "import": "./dist/local/index.js"
    },
    "./electron": {
      "types": "./dist/electron/index.d.ts",
      "import": "./dist/electron/index.js"
    },
    "./electron/preload": {
      "types": "./dist/electron/preload/index.d.ts",
      "import": "./dist/electron/preload/index.js"
    },
    "./electron/renderer": {
      "types": "./dist/electron/renderer/index.d.ts",
      "import": "./dist/electron/renderer/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "drizzle"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/live-smoke.ts",
    "smoke:local": "MARFA_SMOKE_LOCAL=1 tsx scripts/live-smoke.ts"
  },
  "dependencies": {
    "@withmarfa/shared": "workspace:^",
    "oauth4webapi": "^3.8.7"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.1",
    "@libsql/client": "^0.17.4",
    "@tanstack/db": "^0.8.0",
    "@types/node": "^26.2.0",
    "@withmarfa/server": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "@tanstack/db": "^0.8.0",
    "@libsql/client": "^0.17.4",
    "drizzle-orm": "^0.45.2",
    "electron": "^44.2.0"
  },
  "peerDependencies": {
    "@tanstack/db": ">=0.6.17 <0.9.0",
    "@libsql/client": "^0.17.4",
    "drizzle-orm": "^0.45.2",
    "electron": ">=30"
  },
  "peerDependenciesMeta": {
    "@tanstack/db": {
      "optional": true
    },
    "@libsql/client": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "electron": {
      "optional": true
    }
  }
}
