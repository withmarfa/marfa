{
  "name": "@withmarfa/webhooks",
  "version": "1.1.1",
  "license": "Apache-2.0",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "description": "Cross-runtime inbound webhook signature verification (HMAC-SHA256, Slack, Stripe, GitHub). Web Crypto only — runs in Cloudflare Workers and Node 20+ alike.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
