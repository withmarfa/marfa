{
  "name": "@marfa/root",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config --local core.hooksPath hooks || true",
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed origin/main",
    "test:related": "vitest related --run",
    "test:fresh-sqlite": "bash scripts/test-fresh-sqlite.sh",
    "test:pg": "bash scripts/test-pg.sh",
    "test:full": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:fresh-sqlite && pnpm test:pg && pnpm --filter @withmarfa/server run smoke:worker-entry",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "libsql"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "postgres": "^3.4.9",
    "prettier": "^3.8.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "~8.0.16",
    "vitest": "^4.1.8"
  }
}
