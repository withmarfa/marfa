{
  "name": "@marfa/root",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config --local core.hooksPath hooks || true",
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "generate": "pnpm --filter @withmarfa/server run generate:openapi",
    "typecheck": "pnpm -r run typecheck && tsc -p ci --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed origin/main",
    "test:related": "vitest related --run",
    "test:fresh-sqlite": "bash scripts/test-fresh-sqlite.sh",
    "test:offline-lane": "pnpm --filter @withmarfa/conformance test:generators",
    "test:full": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:offline-lane && pnpm test:rust && pnpm test:drift && pnpm test:fresh-sqlite",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:rust": "cd core && cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test && cd bindings/swift && cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test",
    "test:drift": "bash scripts/surface-lock-drift.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "libsql"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "~8.2.1",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
