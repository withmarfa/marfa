# Dependencies
node_modules/

# Build output
dist/

# pnpm pack output — manual first-publish flow leaves a tarball
# in the package directory; never commit it.
*.tgz

# Test coverage
coverage/

# Environment
.env
.env.*
!.env.example

# Registry auth — local devs copy from .npmrc.example with NPM_TOKEN
# set in the shell (publish flow). CI generates .npmrc per-job from
# secrets.GITHUB_TOKEN. Tracking it in the repo caused pnpm to warn
# on every invocation when NPM_TOKEN was unset.
.npmrc

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Logs
*.log

# Seed data (local dev only)
seed/

# Renamed to integrations/sync — keep the old name ignored so stale
# build artifacts can't reappear in checkouts that pre-date the rename.
integrations/sync-agent/

# Database and blob data
data/
.claude/worktrees/

# Deploy artifacts (generated on server, not in repo)
version.json
deploy.log

# Operator deploy config — copy deploy.env.example to deploy.env and fill in.
deploy.env
.claude/settings.local.json
.claude/plans/
.claude/scheduled_tasks.lock
