# Dependencies
node_modules/

# Build output
dist/

# pnpm pack output — manual first-publish flow leaves a tarball
# in the package directory; never commit it.
*.tgz

# Test coverage
coverage/

# Environment
.env
.env.*
!.env.example

# Every dependency comes from the public registry, so no install needs a
# registry credential, and a local one is never tracked.
.npmrc

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Logs
*.log

# Database and blob data
data/
.claude/worktrees/

# The local server the conformance suite boots: its SQLite file, blob
# folder, log, pid and env file. Written per run, never part of the tree.
# The boot scripts write a `.gitignore` into the folder whatever it is
# called; this catches a folder made another way under the names in use.
.marfa-state*
# The restore drill's two instances and its Litestream state, likewise.
.marfa-drill/

# Load and performance reports the conformance suite writes.
reports/

# Written at deploy time, read by the server at boot.
version.json
.claude/settings.local.json
.claude/plans/
.claude/scheduled_tasks.lock

# Page snapshots from a local Playwright CLI run. Machine-local tooling
# output, not part of the project.
.playwright-cli/

# Holding folders for things a session was refused permission to delete
_trash/
_archive/
# Scratch folders: throwaway harnesses, captures and never-tracked files that
# sit in the tree without being part of its source. `eslint.config.js` already
# treats these as an established convention and skips them; without them here,
# the only thing keeping them out of a commit is a contributor's own global
# ignore file.
_tmp/
_local/
_ignore/

