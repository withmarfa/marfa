# Dependencies
node_modules/

# Build output
dist/

# pnpm pack output — manual first-publish flow leaves a tarball
# in the package directory; never commit it.
*.tgz

# Test coverage
coverage/

# Environment
.env
.env.*
!.env.example

# Registry auth — local devs copy from .npmrc.example with NPM_TOKEN
# set in the shell (publish flow). CI generates .npmrc per-job from
# secrets.GITHUB_TOKEN. Tracking it in the repo caused pnpm to warn
# on every invocation when NPM_TOKEN was unset.
.npmrc

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Logs
*.log

# Seed data (local dev only)
seed/

# Database and blob data
data/
.claude/worktrees/

# The local server the conformance suite boots: its SQLite file, blob
# folder, log, pid and env file. Written per run, never part of the tree.
.marfa-state/

# Load and performance reports the conformance suite writes.
reports/

# Written at deploy time, read by the server at boot.
version.json
.claude/settings.local.json
.claude/plans/
.claude/scheduled_tasks.lock

# Wrangler local cache and mid-deploy scratch bundles (generated tool output).
.wrangler/

# Page snapshots from a local Playwright CLI run. Machine-local tooling
# output, not part of the project.
.playwright-cli/

# Deployment env files live on the box, never in git.
infra/digitalocean/.env
infra/digitalocean/server.env
