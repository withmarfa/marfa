# Trees a generator writes, so diffs and the language bar treat them as
# generated. Each is regenerated by `pnpm generate`, by the rules crate or by
# `scripts/icon-sets.sh`, and CI refuses one that no longer matches its source.
# The shapes digest is generated too and left out on purpose: it is committed
# so that a reviewer sees it move.
packages/client/src/generated/** linguist-generated=true
core/marfa-rules/src/contract.rs linguist-generated=true
core/marfa-rules/src/builtin_catalog.json linguist-generated=true
core/marfa-rules/icons/*.json linguist-generated=true
