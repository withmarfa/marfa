#!/usr/bin/env bash
# Pre-push gate (slim): build + typecheck + lint + format:check + test:changed.
#
# `build` runs first because cross-package typechecks resolve workspace
# dependencies through each package's `dist/*.d.ts` — when those are stale
# (e.g. the server's config grew a field that the SDK's tests now
# reference), typecheck fires on the stale declaration instead of current
# source. Building first keeps local typechecks aligned with what CI sees
# on a fresh install.
#
# Scope: SQLite only, only tests whose files changed against `origin/main`.
# Target runtime: sub-30s for a typical small change. The slim gate
# trades dual-dialect coverage for speed — CI runs the full PG + SQLite
# matrix on every PR push, and `pnpm test:full` is the explicit local
# full-matrix run for the pre-PR moment.
#
# Why slim. A pre-push that runs the full ~1800-test dual-dialect suite
# is slow enough that contributors and agents bypass it with
# `--no-verify`. A hook that's bypassed isn't a gate. The slim shape
# stays useful while keeping the load-bearing coverage in CI.
#
# Skippable: `git push --no-verify`. Still authorised when the hook
# hits transient infrastructure flake (Docker daemon down etc.) — but
# the slim shape should make those cases rare.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "═══ pre-push: build + typecheck + lint + format:check + test:changed ═══"
echo "(slim gate; full matrix is \`pnpm test:full\`. skip with --no-verify.)"
echo

pnpm build
pnpm typecheck
pnpm lint
pnpm format:check

# `vitest --changed` needs a git base to compare against. `origin/main`
# matches the typical contributor workflow (branch from main, push to
# remote). Fall back to the full SQLite suite when origin/main isn't
# available locally (fresh clone pre-fetch, detached HEAD, etc.) — we'd
# rather run more than risk skipping coverage of an unknown diff.
if git rev-parse --verify --quiet origin/main >/dev/null; then
  echo "→ test:changed (sqlite, vs origin/main)"
  pnpm test:changed
else
  echo "→ origin/main not found locally; running full sqlite suite"
  pnpm test
fi

echo
echo "═══ ✓ pre-push passed ═══"
echo "Full local matrix: \`pnpm test:full\` (build + typecheck + lint + both dialects)"
