#!/usr/bin/env bash
# Pre-push gate: typecheck + lint + test:fresh-sqlite + test:pg.
#
# Skips the clean install (that's the explicit `pnpm ci-local`) so the hook
# stays fast enough not to become the thing everyone --no-verifies past.
# Enforces the dual-dialect check that local "pnpm test" alone cannot provide.
#
# Skippable: git push --no-verify. Do not ship that as the default flow.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "═══ pre-push: typecheck + lint + test:fresh-sqlite + test:pg ═══"
echo "(skip with --no-verify; full clean-install check is \`pnpm ci-local\`)"
echo

pnpm typecheck
pnpm lint
pnpm test:fresh-sqlite
pnpm test:pg

echo
echo "═══ ✓ pre-push passed ═══"
