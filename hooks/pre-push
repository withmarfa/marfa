#!/usr/bin/env bash
# Pre-push gate: build + typecheck + lint + format:check + offline lane +
# rust + surface-lock drift + test:changed.
#
# **No longer slim, deliberately.** The rust leg runs clippy and the tests on
# two cargo workspaces and is the slowest thing here — it is in because the
# second of those workspaces is reachable from nothing else, and a change to
# a shared error type compiled clean locally and failed on the pool. The
# argument below about a slow hook being a bypassed hook still stands, and
# the answer to it is `--no-verify` for a work-in-progress push rather than a
# gate that does not cover what CI checks.
#
# `build` runs first because cross-package typechecks resolve workspace
# dependencies through each package's `dist/*.d.ts` — when those are stale
# (e.g. the server's config grew a field that the SDK's tests now
# reference), typecheck fires on the stale declaration instead of current
# source. Building first keeps local typechecks aligned with what CI sees
# on a fresh install.
#
# Scope: only tests whose files changed against `origin/main`. CI runs
# the full suite on every PR push, and `pnpm test:full` is the explicit
# local full run for the pre-PR moment.
#
# One exception to "only what changed": the conformance offline lane runs
# every time. It needs no server, takes seconds, and it is the only thing
# that checks the specification against itself — that each chapter's
# statements run 1..n with no gap, and that every citation names something
# that exists. A rebase can join two statements onto one line and leave
# every other suite green, which is how a chapter lost one and reached a
# push.
#
# The cost, and why it is paid. A pre-push that runs the whole suite is slow
# enough that contributors and agents bypass it with `--no-verify`, and a
# hook that's bypassed isn't a gate. So what is here is not everything CI
# runs: the live-server Rust tests, the iOS builds, the Swift packaging and
# the full conformance suite all stay in CI. What is here is the set that has
# actually failed on the pool after passing locally, which is a different and
# much shorter list.
#
# Skippable: `git push --no-verify`.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "═══ pre-push: build + typecheck + lint + format + offline + rust + drift + test:changed ═══"
echo "(the rust leg is the slow one; full run is \`pnpm test:full\`. skip with --no-verify.)"
echo

pnpm build
pnpm typecheck
pnpm lint
pnpm format:check
pnpm test:offline-lane
# The two guards that live outside the command anyone runs. The Swift FFI
# crate is its own workspace, so `cargo test` in `core/` never reaches it and
# a change to a shared error type compiles locally and fails on the pool;
# `surface-lock:drift` takes a base ref, so it exists only as a CI job. Each
# has now cost this repository a red run.
pnpm test:rust
pnpm test:drift

# `vitest --changed` needs a git base to compare against. `origin/main`
# matches the typical contributor workflow (branch from main, push to
# remote). Fall back to the full SQLite suite when origin/main isn't
# available locally (fresh clone pre-fetch, detached HEAD, etc.) — we'd
# rather run more than risk skipping coverage of an unknown diff.
if git rev-parse --verify --quiet origin/main >/dev/null; then
  echo "→ test:changed (sqlite, vs origin/main)"
  pnpm test:changed
else
  echo "→ origin/main not found locally; running full sqlite suite"
  pnpm test
fi

echo
echo "═══ ✓ pre-push passed ═══"
echo "Full local run: \`pnpm test:full\` (build + typecheck + lint + the whole suite)"
