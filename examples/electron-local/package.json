{
  "name": "@withmarfa/example-electron-local",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsup && pnpm run check:targets",
    "check:targets": "tsx scripts/check-native-targets.ts",
    "typecheck": "tsc --noEmit",
    "start": "pnpm run build && electron ."
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@libsql/darwin-arm64": "0.5.29",
    "@libsql/darwin-x64": "0.5.29",
    "@libsql/linux-arm64-gnu": "0.5.29",
    "@libsql/linux-x64-gnu": "0.5.29",
    "@libsql/win32-x64-msvc": "0.5.29",
    "@withmarfa/sdk": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "electron": "^44.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
