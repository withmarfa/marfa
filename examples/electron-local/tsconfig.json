{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // One project for three programs. The renderer needs the DOM and the main
    // process needs Node, and splitting them into two tsconfigs for a sample
    // this size buys less than it costs — at the price that nothing here stops
    // main.ts reaching for `document`.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src", "scripts", "tsup.config.ts"]
}
