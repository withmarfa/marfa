**/node_modules
**/dist
**/*.tsbuildinfo
**/.git
.env
.env.*
data/
*.db
*.db-wal
*.db-shm
.claude/
.github/
.playwright-cli/
coverage/
*.log
seed/

# Scratch directories, gitignored globally rather than per repository. They
# hold whatever somebody was working on locally, so a hand-run
# `docker buildx build .` would otherwise copy it into the build context.
# CI builds from a fresh clone and never sees them.
_tmp/
_local/
_ignore/
