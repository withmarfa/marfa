# Written by `pnpm marfa:up` after the fixture claims the instance.
# There is no default target: an unset MARFA_API_URL stops the run.
MARFA_API_URL=http://127.0.0.1:8600

# Ordinary content credential used to mint bounded per-file keys.
MARFA_API_KEY=

# Ordinary credential with explicit management permissions.
MARFA_MANAGEMENT_KEY=

# Direct owner session and private control socket for owner-only fixtures.
MARFA_OWNER_COOKIE=
MARFA_CONTROL_SOCKET=

# Built device binary; marfa:up does not build this.
#   (cd ../core && cargo build -p marfa-cli)
#   export MARFA_DEVICE_BIN=$PWD/../core/target/debug/marfa
MARFA_DEVICE_BIN=
