# The first three are written by `pnpm marfa:up` to .marfa-state/env; copy them
# from there or set them by hand. The fourth is yours to set, and says so.
# There is no default target: an unset MARFA_API_URL stops the run.
MARFA_API_URL=http://127.0.0.1:8600

# The provisioning key the bootstrap mint returns. It mints every per-file key.
MARFA_API_KEY=

# The operator key, for the operator-only maintenance routes.
MARFA_OPERATOR_KEY=

# The built `marfa` binary, which the device suite drives as the device under
# test. Not one of the three above: `marfa:up` boots a server and a device is
# not one, so nothing writes this for you. From this directory:
#   (cd ../core && cargo build -p marfa-cli)
#   export MARFA_DEVICE_BIN=$PWD/../core/target/debug/marfa
MARFA_DEVICE_BIN=
