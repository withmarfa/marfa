# Written by `pnpm marfa:up` to .marfa-state/env; copy from there or set by hand.
# There is no default target: an unset MARFA_API_URL stops the run.
MARFA_API_URL=http://127.0.0.1:8600

# The provisioning key the bootstrap mint returns. It mints every per-file key.
MARFA_API_KEY=

# The operator key, for the operator-only maintenance routes.
MARFA_OPERATOR_KEY=

# The built `marfa` binary, which the device suite drives as the device under
# test. The conformance job builds it and exports this; a local run points it
# at a debug build:
#   cargo build -p marfa-cli && export MARFA_DEVICE_BIN=$PWD/core/target/debug/marfa
MARFA_DEVICE_BIN=
