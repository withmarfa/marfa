{
  "key": {
    "permissions": ["keys.mint", "items.purge"],
    "type_permissions": {
      "*": "read",
      "core.note": "none",
      "core.task": "write"
    },
    "edge_permissions": { "*": "write" },
    "metadata_permissions": { "*": "write" },
    "profile_permissions": { "*": "read", "name": "write" },
    "extension_permissions": { "app.cursor": "write" }
  },
  "rows": [
    {
      "pattern": "*",
      "page": "Your items",
      "cli": "Your items",
      "level": "Read Only"
    },
    {
      "pattern": "core.note",
      "page": "Note",
      "cli": "core.note",
      "level": "No Access"
    },
    {
      "pattern": "core.task",
      "page": "Task",
      "cli": "core.task",
      "level": "Read and Edit"
    },
    {
      "pattern": "edge.*",
      "page": "Links between items",
      "cli": "Links between items",
      "level": "Read and Edit"
    },
    {
      "pattern": "metadata",
      "page": "Definitions on your server",
      "cli": "Definitions on your server",
      "level": "Read and Edit"
    },
    {
      "pattern": "profile",
      "page": "Your profile",
      "cli": "Your profile",
      "level": "Read Only"
    },
    {
      "pattern": "profile.name",
      "page": "Name",
      "cli": "Name",
      "level": "Read and Edit"
    },
    {
      "pattern": "app.cursor",
      "page": "app.cursor",
      "cli": "app.cursor",
      "level": "Read and Edit"
    }
  ],
  "powers": ["Make keys", "Empty the trash"]
}
