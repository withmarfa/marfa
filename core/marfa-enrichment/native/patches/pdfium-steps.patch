--- a/build.sh
+++ b/build.sh
@@ -134,5 +134,5 @@
 [ $START_STEP -le 6 ] && . steps/06-build.sh
 [ $START_STEP -le 7 ] && . steps/07-stage.sh
 [ $START_STEP -le 8 ] && . steps/08-licenses.sh
-[ $START_STEP -le 9 ] && . steps/09-test.sh
-[ $START_STEP -le 10 ] && . steps/10-pack.sh
+# Marfa links the library into its own program and tests that; it runs neither
+# PDFium's example (step 9) nor packs (step 10).
--- a/steps/02-checkout.sh
+++ b/steps/02-checkout.sh
@@ -21,4 +21,13 @@
   find pdfium -name .git -prune -execdir sh -xc 'git reset --hard && git clean -df' \;
 fi
 
-gclient sync -r "origin/${PDFium_BRANCH:-main}" --no-history --shallow
+gclient sync -r "${PDFium_COMMIT:?}" --no-history --shallow
+
+# Stop before the build if the checkout is not what the pin says: PDFium at the
+# manifest's commit, and each git dependency at the commit its DEPS names. The first
+# line of each list is PDFium, which DEPS does not name.
+test "$(git -C pdfium rev-parse HEAD)" == "$PDFium_COMMIT"
+gclient revinfo --ignore-dep-type cipd --ignore-dep-type gcs >revinfo-pinned
+gclient revinfo --actual --ignore-dep-type cipd --ignore-dep-type gcs >revinfo-actual
+test -n "$(sed 1d revinfo-pinned)"
+diff <(sed 1d revinfo-pinned) <(sed 1d revinfo-actual)
